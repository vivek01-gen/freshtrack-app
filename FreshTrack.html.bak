function updateStorageInfo() {
  var el = document.getElementById("storageInfo");
  if (!el) return;
  var totalItems = state.items.length;
  var totalLists = state.shoppingLists.length;
  var raw = localStorage.getItem("ftdata");
  var size = raw ? (new Blob([raw]).size / 1024).toFixed(1) : "0.0";
  var syms = { INR: "₹", USD: "$", EUR: "€", GBP: "£", JPY: "¥", CNY: "¥" };
  var sym = syms[state.currency] || "₹";
  var val = state.items.reduce(function (a, i) {
    return a + (i.price || 0);
  }, 0);
  el.innerHTML =
    '<div class="storage-info-title">' +
    ics("database", 14, 14) +
    " " +
    tr("storageInfo") +
    '</div><div class="storage-info-item"><span>' +
    ics("package", 12, 12) +
    " " +
    tr("totalItemsLabel") +
    "</span><b>" +
    totalItems +
    '</b></div><div class="storage-info-item"><span>' +
    ics("shoppingBag", 12, 12) +
    " " +
    tr("totalLists") +
    "</span><b>" +
    totalLists +
    '</b></div><div class="storage-info-item"><span>' +
    ics("dollar", 12, 12) +
    " " +
    tr("listPrice") +
    "</span><b>" +
    sym +
    val.toFixed(0) +
    '</b></div><div class="storage-info-item"><span>' +
    ics("database", 12, 12) +
    " " +
    tr("storageSize") +
    "</span><b>" +
    size +
    " KB</b></div>";
}
function showClearShoppingListsDialog() {
  showDialog(tr("clearShoppingLists"), tr("clearShoppingConfirm"), [
    { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
    {
      label: tr("confirm"),
      cls: "btn-danger",
      fn: function () {
        state.shoppingLists = [];
        save();
        renderSettings();
        showToast(tr("shoppingListsCleared"));
      },
    },
  ]);
}
function exportAllData() {
  var data = JSON.stringify(
    {
      items: state.items,
      shoppingLists: state.shoppingLists,
      nextItemId: nextItemId,
      nextListId: nextListId,
      nextShopItemId: nextShopItemId,
      exportedAt: new Date().toISOString(),
      app: "FreshTrack",
      version: "1.0",
    },
    null,
    2,
  );
  var blob = new Blob([data], { type: "application/json" });
  var a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download =
    "FreshTrack_FullBackup_" + new Date().toISOString().slice(0, 10) + ".json";
  a.click();
  showToast(tr("backupDownloaded"));
}
function exportBackup() {
  var data = JSON.stringify({
    items: state.items,
    shoppingLists: state.shoppingLists,
    nextItemId: nextItemId,
    nextListId: nextListId,
    nextShopItemId: nextShopItemId,
    exportedAt: new Date().toISOString(),
  });
  var blob = new Blob([data], { type: "application/json" });
  var a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "FreshTrack_Backup_" + todayStr + ".json";
  a.click();
  showToast(tr("backupDownloaded"));
}
function importBackupFile(e) {
  var file = e.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function (ev) {
    try {
      var data = JSON.parse(ev.target.result);
      if (data.items) state.items = data.items;
      if (data.shoppingLists) state.shoppingLists = data.shoppingLists;
      if (data.nextItemId) nextItemId = data.nextItemId;
      if (data.nextListId) nextListId = data.nextListId;
      if (data.nextShopItemId) nextShopItemId = data.nextShopItemId;
      save();
      showToast(tr("backupRestored"));
      renderHome();
    } catch (ex) {
      showToast(tr("invalidBackup"));
    }
  };
  reader.readAsText(file);
  e.target.value = "";
}
function showResetDialog() {
  showDialog(tr("clearAllData"), tr("clearDataConfirm"), [
    { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
    {
      label: tr("resetAll"),
      cls: "btn-danger",
      fn: function () {
        state.items = [];
        state.shoppingLists = [];
        state.isFirstTime = true;
        nextItemId = 1;
        nextListId = 1;
        nextShopItemId = 1;
        save();
        showToast(tr("resetSuccess"));
        navigate("home");
      },
    },
  ]);
}
function showDeleteExpiredDialog() {
  var expired = state.items.filter(function (i) {
    return daysLeft(i.expiryDate) < 0;
  });
  if (expired.length === 0) {
    showToast(tr("noExpired"));
    return;
  }
  var val = expired.reduce(function (a, i) {
    return a + (i.price || 0);
  }, 0);
  var syms = { INR: "₹", USD: "$", EUR: "€", GBP: "£", JPY: "¥", CNY: "¥" };
  var sym = syms[state.currency] || "₹";
  showDialog(
    tr("deleteExpiredQ"),
    fmt(tr("clearExpiredBody"), { n: expired.length, v: sym + val }),
    [
      { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
      {
        label: tr("delete"),
        cls: "btn-danger",
        fn: function () {
          state.items = state.items.filter(function (i) {
            return daysLeft(i.expiryDate) >= 0;
          });
          save();
          renderHome();
          showToast(tr("expiredCleared"));
        },
      },
    ],
  );
}
function exportCSV() {
  var csv =
    "Item Name,Category,Quantity,Unit,Price,Purchase Date,Expiry Date,Notes\n";
  state.items.forEach(function (i) {
    csv +=
      '"' +
      i.name +
      '","' +
      i.category +
      '",' +
      i.quantity +
      "," +
      i.unit +
      "," +
      (i.price || 0) +
      ',"' +
      i.boughtDate +
      '","' +
      i.expiryDate +
      '","' +
      (i.notes || "") +
      '"\n';
  });
  var blob = new Blob(["\ufeff" + csv], { type: "text/csv;charset=utf-8" });
  var a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "FreshTrack_Inventory.csv";
  a.click();
  showToast(tr("csvExported"));
}
function importCSV(e) {
  var file = e.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function (ev) {
    try {
      var lines = ev.target.result.split("\n").filter(function (l) {
        return l.trim();
      });
      var imported = 0;
      var start = lines[0].toLowerCase().includes("name") ? 1 : 0;
      for (var i = start; i < lines.length; i++) {
        var parts = lines[i].split(",");
        if (parts.length < 2) continue;
        var name = parts[0].replace(/"/g, "").trim();
        if (!name) continue;
        var cat = parts[1]
          ? parts[1].replace(/"/g, "").trim().toLowerCase()
          : "others";
        var qty = parseFloat(parts[2]) || 1;
        var unit = parts[3] ? parts[3].replace(/"/g, "").trim() : "pieces";
        var price = parseFloat(parts[4]) || null;
        if (price === 0) price = null;
        var bought = parts[5] ? parts[5].replace(/"/g, "").trim() : todayStr;
        var expiry = parts[6] ? parts[6].replace(/"/g, "").trim() : todayStr;
        var notes = parts[7] ? parts[7].replace(/"/g, "").trim() : "";
        state.items.push({
          id: nextItemId++,
          name: name,
          category: cat,
          quantity: qty,
          unit: unit,
          price: price,
          boughtDate: bought,
          expiryDate: expiry,
          notes: notes,
        });
        imported++;
      }
      save();
      renderHome();
      showToast(tr("importSuccess") + " " + imported + " items!");
    } catch (ex) {
      showToast(tr("importFailed"));
    }
  };
  reader.readAsText(file);
  e.target.value = "";
}
function selectLangFromSheet(c) {
  state.lang = c;
  save();
  closeDialog();
  var ov = document.getElementById("langSheetOverlay");
  if (ov) {
    ov.remove();
    setOverlayLock(false);
  }
  var v = state.currentView;
  if (v === "home") renderHome();
  else if (v === "shopping") renderShopping();
  else if (v === "analytics") renderAnalytics();
  else if (v === "settings") renderSettings();
  refreshUI();
}
function showCurrencyPicker() {
  var currencies = ["INR", "USD", "EUR", "GBP", "JPY", "CNY"];
  var symbols = { INR: "₹", USD: "$", EUR: "€", GBP: "£", JPY: "¥", CNY: "¥" };
  var names = {
    INR: "curINR",
    USD: "curUSD",
    EUR: "curEUR",
    GBP: "curGBP",
    JPY: "curJPY",
    CNY: "curCNY",
  };
  var items = currencies
    .map(function (c) {
      return (
        '<div class="bs-item' +
        (state.currency === c ? " active" : "") +
        '" onclick="state.currency=\'' +
        c +
        '\';save();closeLangSheet();renderSettings()"><span class="lang-flag" style="font-size:20px">' +
        symbols[c] +
        '</span><div><div class="lang-native">' +
        tr(names[c]) +
        '</div><div class="lang-english">' +
        c +
        "</div></div>" +
        ics("check", 18, 18) +
        "</div>"
      );
    })
    .join("");
  showSheet("currencyOverlay", tr("selectCurrency"), items);
}
function showDateFormatPicker() {
  var fmts = ["DD/MM/YYYY", "MM/DD/YYYY", "YYYY-MM-DD", "DD.MM.YYYY"];
  var items = fmts
    .map(function (f) {
      var sample = f
        .replace("YYYY", "2026")
        .replace("MM", "08")
        .replace("DD", "01");
      return (
        '<div class="bs-item' +
        (state.dateFormat === f ? " active" : "") +
        '" onclick="state.dateFormat=\'' +
        f +
        '\';save();closeLangSheet();renderSettings()"><span class="lang-flag" style="font-size:16px">' +
        ics("calendar", 18, 18) +
        '</span><div><div class="lang-native" style="font-size:13px">' +
        sample +
        '</div><div class="lang-english">' +
        f +
        "</div></div>" +
        ics("check", 18, 18) +
        "</div>"
      );
    })
    .join("");
  showSheet("dateOverlay", tr("selectFormat"), items);
}
function showUnitPicker() {
  var units = ["metric", "imperial"];
  var items = units
    .map(function (u) {
      return (
        '<div class="bs-item' +
        (state.measureUnit === u ? " active" : "") +
        '" onclick="state.measureUnit=\'' +
        u +
        '\';save();closeLangSheet();renderSettings()"><span class="lang-flag" style="font-size:18px">' +
        ics("ruler", 18, 18) +
        '</span><div><div class="lang-native" style="font-size:13px">' +
        (u === "metric" ? tr("metricUnit") : tr("imperialUnit")) +
        "</div></div>" +
        ics("check", 18, 18) +
        "</div>"
      );
    })
    .join("");
  showSheet("unitOverlay", tr("selectUnit"), items);
}
function closeLangSheet() {
  ["langSheetOverlay", "currencyOverlay", "dateOverlay", "unitOverlay"].forEach(
    function (id) {
      var el = document.getElementById(id);
      if (el) el.remove();
    },
  );
  setOverlayLock(false);
}
function showSetPIN() {
  showDialog(
    tr("setPIN"),
    '<input type="password" id="pinInput1" class="form-input" placeholder="' +
      tr("enterPIN") +
      '" style="margin-bottom:8px" maxlength="6" inputmode="numeric"><input type="password" id="pinInput2" class="form-input" placeholder="' +
      tr("confirmPIN") +
      '" maxlength="6" inputmode="numeric">',
    [
      { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
      {
        label: tr("save"),
        cls: "btn-primary",
        fn: function () {
          var p1 = document.getElementById("pinInput1").value;
          var p2 = document.getElementById("pinInput2").value;
          if (!p1 || p1.length < 4) {
            showToast(tr("pinTooShort"));
            return;
          }
          if (p1 !== p2) {
            showToast(tr("pinMismatch"));
            return;
          }
          state.appLock = true;
          state.lockPIN = p1;
          save();
          closeDialog();
          renderSettings();
          showToast(tr("lockEnabled"));
        },
      },
    ],
  );
}
function applyAccent() {
  var colors = {
    green: "#22C55E",
    blue: "#3B82F6",
    purple: "#8B5CF6",
    orange: "#F97316",
  };
  var c = colors[state.accentColor] || "#22C55E";
  document.documentElement.style.setProperty("--accent", c);
  document.documentElement.style.setProperty("--fab-bg", c);
  var meta = document.querySelector('meta[name="theme-color"]');
  if (meta) meta.setAttribute("content", state.isDark ? "#0F201B" : c);
}
function applyFont() {
  var sizes = { s: "12px", m: "14px", l: "16px" };
  var sz = sizes[state.fontSize] || "14px";
  var cc = document.querySelector(".app-container");
  if (cc) cc.style.fontSize = sz;
}
function resetSettings() {
  showDialog(tr("resetSettings"), tr("resetSettingsConfirm"), [
    { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
    {
      label: tr("confirm"),
      cls: "btn-danger",
      fn: function () {
        state.currency = "INR";
        state.dateFormat = "DD/MM/YYYY";
        state.measureUnit = "metric";
        state.accentColor = "green";
        state.fontSize = "m";
        state.notificationTime = "10:00";
        state.reminderDays = [3];
        state.notificationsOn = true;
        state.appLock = false;
        state.lockPIN = "";
        state.privacyMode = false;
        state.autoBackup = false;
        state.themeMode = "light";
        state.isDark = false;
        applyTheme();
        applyAccent();
        applyFont();
        save();
        renderSettings();
        showToast(tr("settingsReset"));
      },
    },
  ]);
}
function clearCache() {
  showDialog(tr("clearCache"), tr("clearCacheConfirm"), [
    { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
    {
      label: tr("confirm"),
      cls: "btn-danger",
      fn: function () {
        localStorage.removeItem("ftdata");
        state.items = [];
        state.shoppingLists = [];
        nextItemId = 1;
        nextListId = 1;
        nextShopItemId = 1;
        save();
        showToast(tr("cacheCleared"));
        navigate("home");
      },
    },
  ]);
}

var CAT_ICON = {
  fruits_veg: "shopping",
  dairy_eggs: "package",
  bakery_bread: "package",
  meat_seafood: "tag",
  pantry_grains: "package",
  beverages: "shopping",
  others: "tag",
};
var deferredInstallPrompt = null;
var pwaInstalled = false;

function initPWA() {
  window.addEventListener("beforeinstallprompt", function (e) {
    e.preventDefault();
    deferredInstallPrompt = e;
    renderSettings();
  });
  window.addEventListener("appinstalled", function () {
    pwaInstalled = true;
    deferredInstallPrompt = null;
    showToast(tr("appReadyOffline"));
    renderSettings();
  });
  var updateOnline = function () {
    var el = document.getElementById("offlineBanner");
    if (el) {
      if (!navigator.onLine) {
        el.innerHTML = "<span>" + tr("youAreOffline") + "</span>";
        el.style.display = "flex";
      } else {
        el.style.display = "none";
      }
    }
    if (state.currentView === "settings") {
      renderSettings();
    }
  };
  window.addEventListener("online", updateOnline);
  window.addEventListener("offline", updateOnline);
  updateOnline();
  registerSW();
  if (
    window.matchMedia &&
    window.matchMedia("(display-mode: standalone)").matches
  ) {
    pwaInstalled = true;
  }
}
function installApp() {
  if (!deferredInstallPrompt) {
    showToast(tr("installFailed"));
    return;
  }
  deferredInstallPrompt.prompt();
  deferredInstallPrompt.userChoice.then(function (choice) {
    if (choice.outcome === "accepted") {
      pwaInstalled = true;
      showToast(tr("appReadyOffline"));
      renderSettings();
    }
    deferredInstallPrompt = null;
  });
}
function registerSW() {
  if (!("serviceWorker" in navigator)) return;
  var swCode =
    "self.addEventListener('install',function(e){self.skipWaiting();e.waitUntil(caches.open('freshtrack-v1').then(function(c){return c.addAll(['./FreshTrack.html','./']);}).catch(function(){}));});" +
    "self.addEventListener('activate',function(e){e.waitUntil(self.clients.claim());});" +
    "self.addEventListener('fetch',function(e){e.respondWith(caches.match(e.request,{ignoreSearch:true}).then(function(r){if(r)return r;return fetch(e.request).then(function(res){if(res&&res.ok&&e.request.method==='GET'){var cl=res.clone();caches.open('freshtrack-v1').then(function(c){c.put(e.request,cl);}).catch(function(){});}return res;}).catch(function(){return caches.match('./FreshTrack.html');});}));});";
  var blob = new Blob([swCode], { type: "text/javascript" });
  var url = URL.createObjectURL(blob);
  navigator.serviceWorker
    .register(url, { scope: "./" })
    .then(function () {})
    .catch(function () {});
}

function fillStaticIcons() {
  var map = [
    [document.querySelectorAll(".header-back"), "back"],
    [document.querySelectorAll("#fabAdd .icon"), "plus"],
    [document.querySelectorAll("#shopFab .icon"), "plusCircle"],
    [document.querySelectorAll(".legal-close .icon"), "x"],
    [document.querySelectorAll(".quick-actions button"), "quickActions"],
  ];
  map.forEach(function (pair) {
    var els = pair[0];
    if (!els || !els.length) return;
    if (pair[1] === "quickActions") {
      var ids = ["bulkDeleteLabel", "csvLabel", "importCsvLabel"];
      var names = ["trash2", "download", "upload"];
      els.forEach(function (b, i) {
        var sp = b.querySelector(".icon");
        if (sp && ids[i] && document.getElementById(ids[i])) {
          sp.innerHTML = ICONS[names[i]];
        }
      });
      return;
    }
    els.forEach(function (el) {
      var sp = el.querySelector(".icon") || el;
      if (sp) sp.innerHTML = ICONS[pair[1]];
    });
  });
}

fillStaticIcons();
initPWA();
load();
applyTheme();
refreshUI();
</script></body></html>
