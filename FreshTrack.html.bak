    '<div class="sl-empty-dot d1"></div><div class="sl-empty-dot d2"></div>' +
    '<div class="sl-empty-check">' +
    ics("check", 18, 18) +
    "</div></div>" +
    '<div class="sl-empty-title">' +
    tr("noLists") +
    '</div><div class="sl-empty-sub">' +
    tr("emptyListsMsg") +
    '</div><button class="empty-cta sl-empty-cta" onclick="slNewList()">' +
    ics("plus", 16, 16) +
    " " +
    tr("createFirstList") +
    "</button>" +
    '<div class="sl-tips"><div class="sl-tips-title">' +
    tr("quickTips") +
    "</div>" +
    '<div class="sl-tip-row">' +
    ics("plus", 12, 12) +
    " " +
    tr("tipCreate") +
    '</div><div class="sl-tip-row">' +
    ics("check", 12, 12) +
    " " +
    tr("tipCheck") +
    '</div><div class="sl-tip-row">' +
    ics("template", 12, 12) +
    " " +
    tr("tipTemplate") +
    '</div><div class="sl-tip-row">' +
    ics("archive", 12, 12) +
    " " +
    tr("tipArchive") +
    "</div></div>" +
    '<div class="sl-tpl-suggest">' +
    '<div class="sl-tips-title">' +
    tr("templateSuggestions") +
    "</div>" +
