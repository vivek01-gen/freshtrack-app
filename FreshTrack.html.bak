var todayStr = now.toISOString().slice(0, 10);
window._selCat = "fruits_veg";
window._selUnit = "pieces";
window._photo = null;
var state = {
  items: [],
  shoppingLists: [],
  isDark: false,
  lang: "en",
  isFirstTime: true,
  notificationsOn: true,
  currency: "INR",
  dateFormat: "DD/MM/YYYY",
  measureUnit: "metric",
  accentColor: "green",
  fontSize: "m",
  notificationTime: "10:00",
  reminderDays: [3],
  themeMode: "light",
  appLock: false,
  lockPIN: "",
  privacyMode: false,
  autoBackup: false,
  currentView: "home",
  editingItemId: null,
  activeListId: null,
  filterTab: "all",
  search: "",
  onboardingPage: 1,
  privacyTerms: false,
  safetyDisclaimer: false,
  recentItems: [],
};
var nextItemId = 1,
  nextListId = 1,
  nextShopItemId = 1;
function tr(key) {
  return (
    (state.lang !== "en" && t[state.lang] && t[state.lang][key]) ||
    t.en[key] ||
    key
  );
}

function fmt(tpl, data) {
  return String(tpl).replace(/\{(\w+)\}/g, function (m, k) {
    return Object.prototype.hasOwnProperty.call(data, k) ? String(data[k]) : m;
  });
}
function daysLeft(d) {
  var e = new Date(d);
  e.setHours(0, 0, 0, 0);
  var n = new Date();
  n.setHours(0, 0, 0, 0);
  return Math.round((e - n) / 86400000);
}
function getStatus(d) {
  var dl = daysLeft(d);
  return dl > 3 ? "fresh" : dl > 0 ? "soon" : dl === 0 ? "today" : "expired";
}
function catLabel(c) {
  var m = CAT_LOC[state.lang];
  return (m && m[c]) || CAT_LOC.en[c] || c;
}
function esc(s) {
  return String(s == null ? "" : s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}
function save() {
  localStorage.setItem(
    "ftdata",
    JSON.stringify({
      items: state.items,
      shoppingLists: state.shoppingLists,
      nextItemId: nextItemId,
      nextListId: nextListId,
      nextShopItemId: nextShopItemId,
      isDark: state.isDark,
      lang: state.lang,
      isFirstTime: state.isFirstTime,
      notificationsOn: state.notificationsOn,
      currency: state.currency,
      dateFormat: state.dateFormat,
      measureUnit: state.measureUnit,
      accentColor: state.accentColor,
      fontSize: state.fontSize,
      notificationTime: state.notificationTime,
      reminderDays: state.reminderDays,
      themeMode: state.themeMode,
      appLock: state.appLock,
      lockPIN: state.lockPIN,
      privacyMode: state.privacyMode,
      autoBackup: state.autoBackup,
      recentItems: state.recentItems,
    }),
  );
}
function load() {
  try {
    var d = JSON.parse(localStorage.getItem("ftdata"));
    if (!d) return;
    state.items = d.items || [];
    state.shoppingLists = d.shoppingLists || [];
    normalizeShoppingData();
    nextItemId = d.nextItemId || 1;
    nextListId = d.nextListId || 1;
    nextShopItemId = d.nextShopItemId || 1;
    state.isDark = d.isDark || false;
    state.lang = d.lang || "en";
    state.isFirstTime = d.isFirstTime !== undefined ? d.isFirstTime : true;
    state.notificationsOn =
      d.notificationsOn !== undefined ? d.notificationsOn : true;
    state.currency = d.currency || "INR";
    state.dateFormat = d.dateFormat || "DD/MM/YYYY";
    state.measureUnit = d.measureUnit || "metric";
    state.accentColor = d.accentColor || "green";
    state.fontSize = d.fontSize || "m";
    state.notificationTime = d.notificationTime || "10:00";
    state.reminderDays = d.reminderDays || [3];
    state.themeMode = d.themeMode || "light";
    state.appLock = d.appLock || false;
    state.lockPIN = d.lockPIN || "";
    state.privacyMode = d.privacyMode || false;
    state.autoBackup = d.autoBackup || false;
    state.recentItems = Array.isArray(d.recentItems) ? d.recentItems : [];
  } catch (e) {}
}
var _overlayLocks = 0;
function setOverlayLock(open) {
  _overlayLocks = Math.max(0, _overlayLocks + (open ? 1 : -1));
  document.body.classList.toggle("modal-open", _overlayLocks > 0);
}
function showScreen(id) {
  document.querySelectorAll(".screen").forEach(function (s) {
    s.classList.remove("active");
  });
  var el = document.getElementById(id);
  if (el) {
    el.classList.add("active");
    var ms = el.querySelector(".main-scroll");
    if (ms) ms.scrollTop = 0;
  }
}
function showToast(msg) {
  var c = document.getElementById("toastContainer");
  var t = document.createElement("div");
  t.className = "toast";
  t.textContent = msg;
  c.appendChild(t);
  setTimeout(function () {
    t.style.opacity = "0";
    t.style.transition = "opacity .3s";
    setTimeout(function () {
      t.remove();
    }, 300);
  }, 2500);
}
function showDialog(title, text, buttons) {
  document.getElementById("dialogOverlay").classList.add("show");
  setOverlayLock(true);
  var box = document.getElementById("dialogBox");
  var bts = buttons
    .map(function (b) {
      var fnSrc = b.fn
        .toString()
        .replace(/&/g, "&amp;")
        .replace(/"/g, "&quot;");
      return (
        '<button class="' +
        b.cls +
        '" onclick="(' +
        fnSrc +
        ')();closeDialog()">' +
        b.label +
        "</button>"
      );
    })
    .join("");
  box.innerHTML =
    '<div class="dialog-title">' +
    title +
    '</div><div class="dialog-text">' +
    text +
    '</div><div class="dialog-actions">' +
    bts +
    "</div>";
}
function closeDialog() {
  document.getElementById("dialogOverlay").classList.remove("show");
  setOverlayLock(false);
}
function applyTheme() {
  var c = document.querySelector(".app-container");
  if (c) {
    if (state.themeMode === "system") {
      var sys =
        window.matchMedia &&
        window.matchMedia("(prefers-color-scheme:dark)").matches;
      c.classList.toggle("dark", sys);
    } else {
      c.classList.toggle("dark", state.isDark);
    }
  }
  var tb = document.getElementById("themeToggle");
  if (tb) {
    var i = tb.querySelector(".icon");
    if (i) i.innerHTML = state.isDark ? ICONS.sun : ICONS.moon;
  }
  applyAccent();
  applyFont();
}
function toggleTheme() {
  state.isDark = !state.isDark;
  applyTheme();
  save();
}
function ic(name) {
  return '<span class="icon">' + ICONS[name] + "</span>";
}
function ics(name, w, h) {
  return (
    '<span class="icon" style="width:' +
    w +
    "px;height:" +
    h +
    'px">' +
    ICONS[name] +
    "</span>"
  );
}
function refreshUI() {
  applyTheme();
  var m = [
    ["headerTitle", "appName"],
    ["homeSubtitle", "subtitle"],
    ["inventoryTitle", "myInventory"],
    ["bulkDeleteLabel", "bulkDelete"],
    ["csvLabel", "csv"],
    ["navHome", "home"],
    ["navShopping", "shoppingList"],
    ["navAnalytics", "analytics"],
    ["navSettings", "settings"],
    ["shoppingTitle", "shoppingListTitle"],
    ["analyticsTitle", "analytics"],
    ["settingsTitle", "settings"],
    ["legalTitle", "legal"],
    ["splashTagline", "groceryAssistant"],
    ["shoppingSubtitle", "groceryNotepad"],
    ["analyticsSubtitle", "spendHub"],
    ["settingsSubtitle", "configuration"],
    ["importCsvLabel", "importCsv"],
  ];
  m.forEach(function (p) {
    var e = document.getElementById(p[0]);
    if (e) e.textContent = tr(p[1]);
  });
  document.title = tr("appName");
  var si = document.getElementById("searchInput");
  if (si) si.placeholder = tr("searchItems");
  var ni = [
    "navHomeIcon",
    "navShoppingIcon",
    "navAnalyticsIcon",
    "navSettingsIcon",
  ];
  var nk = ["home", "shopping", "analytics", "settings"];
  ni.forEach(function (id, i) {
    var e = document.getElementById(id);
    if (e) e.innerHTML = ICONS[nk[i]];
  });
  var f = document.getElementById("fabAdd");
  if (f) f.setAttribute("aria-label", tr("addItem"));
  var am = document.getElementById("addItemModal");
  if (am) am.setAttribute("aria-label", tr("addItem"));
  var qa = document.getElementById("slQaName");
  if (qa) qa.placeholder = tr("addItemPh");
}
function navigate(view, addToStack) {
  state.currentView = view;
  document.querySelectorAll(".nav-item").forEach(function (n) {
    n.classList.toggle("active", n.dataset.nav === view);
  });
  if (addToStack !== false && navStack[navStack.length - 1] !== view)
    navStack.push(view);
  if (view === "home") {
    showScreen("homeScreen");
    renderHome();
  } else if (view === "shopping") {
    showScreen("shoppingScreen");
    renderShopping();
  } else if (view === "analytics") {
    showScreen("analyticsScreen");
    renderAnalytics();
  } else if (view === "settings") {
    showScreen("settingsScreen");
    renderSettings();
  }
  refreshUI();
}
function navigateBack() {
  if (navStack.length > 1) {
    navStack.pop();
    navigate(navStack.pop(), false);
  }
}
setTimeout(function () {
  load();
  applyTheme();
  refreshUI();
  if (state.isFirstTime) {
    showScreen("onboardScreen");
    renderOnboarding();
  } else {
    navigate("home");
  }
}, 2500);
function openLegal(tab) {
  document.getElementById("legalModal").classList.add("show");
  setOverlayLock(true);
  switchLegalTab(tab || "privacy", document.querySelector(".legal-tab"));
}
function closeLegal() {
  document.getElementById("legalModal").classList.remove("show");
  setOverlayLock(false);
}
function switchLegalTab(tab, btn) {
  document.querySelectorAll(".legal-tab").forEach(function (el) {
    el.classList.remove("active");
  });
  if (btn) btn.classList.add("active");
  var body = document.getElementById("legalBody");
  var c = "";
  if (tab === "privacy") {
    c =
      "<h3>" +
      tr("privacy") +
      "</h3><p>" +
      tr("privacyText") +
      "</p><ul><li>" +
      tr("privacyL1") +
      "</li><li>" +
      tr("privacyL2") +
      "</li><li>" +
      tr("privacyL3") +
      "</li><li>" +
      tr("privacyL4") +
      "</li><li>" +
      tr("privacyL5") +
      "</li></ul>";
  } else if (tab === "terms") {
    c =
      "<h3>" +
      tr("termsOfService") +
      "</h3><p>" +
      tr("termsText") +
      "</p><ul><li>" +
      tr("termsL1") +
      "</li><li>" +
      tr("termsL2") +
      "</li><li>" +
      tr("termsL3") +
      "</li><li>" +
      tr("termsL4") +
      "</li></ul>";
  } else if (tab === "safety") {
    c =
      "<h3>" +
      tr("foodSafety") +
      "</h3><p>" +
      tr("safetyText") +
      "</p><ul><li>" +
      tr("safetyL1") +
      "</li><li>" +
      tr("safetyL2") +
      "</li><li>" +
      tr("safetyL3") +
      "</li><li>" +
      tr("safetyL4") +
      "</li></ul>";
  } else if (tab === "about") {
    c =
      "<h3>" +
      tr("aboutFreshTrack") +
      "</h3><p>" +
      tr("aboutDesc") +
      "</p><ul><li>" +
      tr("aboutVersion") +
      "</li><li>" +
      tr("aboutLicense") +
      "</li><li>" +
      tr("aboutPlatform") +
      "</li><li>" +
      tr("aboutStorage") +
      "</li><li>" +
      tr("aboutLanguages") +
      "</li></ul>";
  }
  body.innerHTML = c;
}

function renderOnboarding() {
  var p = state.onboardingPage;
  var card = document.getElementById("onboardCard");
  var content = "";
  if (p === 1) {
    content =
      '<div style=\"text-align:center\"><div style=\"width:70px;height:70px;border-radius:50%;background:#CFE8C9;display:flex;align-items:center;justify-content:center;margin:0 auto 12px\">' +
      ics("leaf", 46, 46) +
      '</div><h2 style=\"font-size:20px;font-weight:900\">' +
      tr("onboardWelcome") +
      '</h2><p style=\"color:#00C897;font-weight:700;font-size:12px\">' +
      tr("onboardTag") +
      '</p><p style=\"font-size:12px;line-height:1.5;margin-top:8px;color:#4A6F62\">' +
      tr("onboardDesc") +
      '</p></div><div style=\"background:#F0FDF4;border-radius:18px;padding:14px;margin-top:12px\">' +
      tr("onboardFeatures")
        .split(" \\u2022 ")
        .map(function (f) {
          return (
            '<div style=\"display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;padding:4px 0\">' +
            ics("star", 14, 14) +
            " " +
            f +
            "</div>"
          );
        })
        .join("") +
      "</div>";
  } else if (p === 2) {
    content =
      '<h2 style=\"font-size:18px;font-weight:900\">' +
      ics("lock", 20, 20) +
      " " +
      tr("onboardPrivacy") +
      '</h2><p style=\"font-size:12px;color:#4A6F62;line-height:1.5\">' +
      tr("onboardPrivacyDesc") +
      '</p><hr style=\"border:none;border-top:1px solid #CFE8C9;margin:12px 0\"><h3 style=\"font-size:13px;font-weight:700\">' +
      ics("alertTriangle", 16, 16) +
      " " +
      tr("onboardDisclaimer") +
      '</h3><p style=\"font-size:11px;color:#4A6F62;line-height:1.4\">' +
      tr("onboardDisclaimerDesc") +
      '</p><div style=\"margin-top:12px\"><label style=\"display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer\"><input type=\"checkbox\" id=\"privacyCb\" ' +
      (state.privacyTerms ? "checked" : "") +
      ' onchange=\"state.privacyTerms=this.checked;renderOnboarding()\"> <span>' +
      tr("onboardAgreeTerms") +
      '</span></label><label style=\"display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer;margin-top:8px\"><input type=\"checkbox\" id=\"safetyCb\" ' +
      (state.safetyDisclaimer ? "checked" : "") +
      ' onchange=\"state.safetyDisclaimer=this.checked;renderOnboarding()\"> <span>' +
      tr("onboardAckSafety") +
      "</span></label></div>";
  } else if (p === 3) {
    content =
      '<div style=\"text-align:center\"><div style=\"width:70px;height:70px;border-radius:50%;background:#CFE8C9;display:flex;align-items:center;justify-content:center;margin:0 auto 12px\">' +
      ics("check", 36, 36) +
      '</div><h2 style=\"font-size:18px;font-weight:900\">' +
      tr("onboardWelcome") +
      '</h2><p style=\"font-size:12px;color:#4A6F62;line-height:1.5\">' +
      tr("onboardReadyDesc") +
      '</p><div style=\"margin:16px 0;display:flex;justify-content:center;gap:12px\"><div style=\"text-align:center\"><div style=\"width:36px;height:36px;border-radius:10px;background:#E6FAF4;display:flex;align-items:center;justify-content:center;margin:0 auto 4px\">' +
      ics("package", 18, 18) +
      '</div><div style=\"font-size:9px;color:#4A6F62\">' +
      tr("inventory") +
      '</div></div><div style=\"text-align:center\"><div style=\"width:36px;height:36px;border-radius:10px;background:#E6FAF4;display:flex;align-items:center;justify-content:center;margin:0 auto 4px\">' +
      ics("shopping", 18, 18) +
      '</div><div style=\"font-size:9px;color:#4A6F62\">' +
      tr("shoppingList") +
      '</div></div><div style=\"text-align:center\"><div style=\"width:36px;height:36px;border-radius:10px;background:#E6FAF4;display:flex;align-items:center;justify-content:center;margin:0 auto 4px\">' +
      ics("analytics", 18, 18) +
      '</div><div style=\"font-size:9px;color:#4A6F62\">' +
      tr("analytics") +
      "</div></div></div></div>";
  }
  card.innerHTML =
    content +
    '<div class=\"onboard-nav\"><div class=\"onboard-dots\">' +
    [1, 2, 3]
      .map(function (d) {
        return (
          '<div class=\"onboard-dot' + (p === d ? " active" : "") + '\"></div>'
        );
      })
      .join("") +
    '</div><div style=\"display:flex;gap:8px\">' +
    (p > 1
      ? '<button class=\"onboard-btn secondary\" onclick=\"onboardPrev()\">' +
        tr("back") +
        "</button>"
      : "<div></div>") +
    (p < 3
      ? '<button class=\"onboard-btn primary\" onclick=\"onboardNext()\">' +
        tr("next") +
        "</button>"
      : '<button class=\"onboard-btn primary\" onclick=\"finishOnboarding()\">' +
        tr("getStarted") +
        "</button>") +
    "</div></div>";
}
function onboardNext() {
  if (
    state.onboardingPage === 2 &&
    (!state.privacyTerms || !state.safetyDisclaimer)
  )
    return;
  if (state.onboardingPage < 3) {
    state.onboardingPage++;
    renderOnboarding();
  }
}
function onboardPrev() {
  if (state.onboardingPage > 1) {
    state.onboardingPage--;
    renderOnboarding();
  }
}
function finishOnboarding() {
  state.isFirstTime = false;
  save();
  navigate("home");
}
function showSheet(overlayId, title, bodyHtml) {
  var overlay = document.createElement("div");
  overlay.className = "bs-overlay";
  overlay.id = overlayId;
  overlay.innerHTML =
    '<div class="bs-sheet"><div class="bs-handle"></div><div class="bs-title">' +
    title +
    "</div>" +
    bodyHtml +
    "</div>";
  overlay.addEventListener("click", function (e) {
    if (e.target === overlay) {
      overlay.remove();
      setOverlayLock(false);
    }
  });
  document.body.appendChild(overlay);
  setOverlayLock(true);
  setTimeout(function () {
    overlay.classList.add("show");
  }, 10);
}
function showLangPicker() {
  var items = LANGUAGES.map(function (l) {
    return (
      '<div class="bs-item' +
      (state.lang === l[0] ? " active" : "") +
      '" onclick="selectLangFromSheet(\'' +
      l[0] +
      '\')"><span class="lang-flag">' +
      LANG_FLAGS[l[0]] +
      '</span><div><div class="lang-native">' +
      LANG_NATIVE[l[0]] +
      '</div><div class="lang-english">' +
      l[1] +
      "</div></div>" +
      ics("check", 18, 18) +
      "</div>"
    );
  }).join("");
  showSheet("langSheetOverlay", tr("selectLanguage"), items);
}
function showLangSheet() {
  showLangPicker();
}
function setLang(c) {
  state.lang = c;
  save();
  closeDialog();
  var v = state.currentView;
  if (v === "home") renderHome();
  else if (v === "shopping") renderShopping();
  else if (v === "analytics") renderAnalytics();
  else if (v === "settings") renderSettings();
  refreshUI();
}
function renderHome() {
  applyTheme();
  refreshUI();
  var items = state.items;
  var total = items.length;
  var soon = items.filter(function (i) {
    var d = daysLeft(i.expiryDate);
    return d >= 0 && d <= 3;
  }).length;
  var exp = items.filter(function (i) {
    return daysLeft(i.expiryDate) < 0;
  }).length;
  var todayItems = items.filter(function (i) {
    return daysLeft(i.expiryDate) === 0;
  });
  var alertEl = document.getElementById("alertBanner");
  if (todayItems.length > 0) {
    alertEl.style.display = "flex";
    alertEl.innerHTML =
      ics("alertBell", 16, 16) +
      '<span style=\"display:flex;align-items:center;gap:4px\"><span id=\"alertCount\">' +
      todayItems.length +
      "</span> " +
      tr("alerts") +
      "</span>";
  } else {
    alertEl.style.display = "none";
  }
  document.getElementById("statsRow").innerHTML =
    '<div class=\"stat-card\" style=\"border-color:rgba(0,200,151,.3);background:' +
    (state.isDark ? "rgba(0,200,151,.08)" : "rgba(0,200,151,.04)") +
    '\" onclick=\"setFilter(\'all\')\"><div class=\"stat-top\"><div class=\"stat-icon\" style=\"border-color:#00C897;color:#00C897\">' +
    ics("package", 18, 18) +
    '</div><div class=\"stat-dot\" style=\"background:#00C897\"></div></div><div><div class=\"stat-count\" style=\"color:' +
    (state.isDark ? "#fff" : "#00C897") +
    '\">' +
    total +
    '</div><div class=\"stat-label\">' +
    tr("totalItems") +
    '</div><div class=\"stat-sub\">' +
    tr("statTotalSubtitle") +
    '</div></div></div><div class=\"stat-card\" style=\"border-color:rgba(245,158,11,.3);background:' +
    (state.isDark ? "rgba(245,158,11,.08)" : "rgba(245,158,11,.04)") +
    '\" onclick=\"setFilter(\'soon\')\"><div class=\"stat-top\"><div class=\"stat-icon\" style=\"border-color:#F59E0B;color:#F59E0B\">' +
    ics("clock", 18, 18) +
    '</div><div class=\"stat-dot\" style=\"background:#F59E0B\"></div></div><div><div class=\"stat-count\" style=\"color:' +
    (state.isDark ? "#fff" : "#F59E0B") +
    '\">' +
    soon +
    '</div><div class=\"stat-label\">' +
    tr("expiringSoon") +
    '</div><div class=\"stat-sub\">' +
    tr("statSoonSubtitle") +
    '</div></div></div><div class=\"stat-card\" style=\"border-color:rgba(239,68,68,.3);background:' +
    (state.isDark ? "rgba(239,68,68,.08)" : "rgba(239,68,68,.04)") +
    '\" onclick=\"setFilter(\'expired\')\"><div class=\"stat-top\"><div class=\"stat-icon\" style=\"border-color:#EF4444;color:#EF4444\">' +
    ics("alertTriangle", 18, 18) +
    '</div><div class=\"stat-dot\" style=\"background:#EF4444\"></div></div><div><div class=\"stat-count\" style=\"color:' +
    (state.isDark ? "#fff" : "#EF4444") +
    '\">' +
    exp +
    '</div><div class=\"stat-label\">' +
    tr("expired") +
    '</div><div class=\"stat-sub\">' +
    tr("statExpiredSubtitle") +
    "</div></div></div>";
  document.getElementById("filterRow").innerHTML = [
    { key: "all", icon: "package", label: "filterAll" },
    { key: "fresh", icon: "check", label: "filterFresh" },
    { key: "soon", icon: "clock", label: "filterExpiring" },
    { key: "expired", icon: "alertTriangle", label: "filterExpired" },
  ]
    .map(function (f) {
      return (
        '<div class="filter-chip' +
        (state.filterTab === f.key ? " active" : "") +
        '" onclick="setFilter(\'' +
        f.key +
        "')\">" +
        ics(f.icon, 14, 14) +
        " " +
        tr(f.label) +
        "</div>"
      );
    })
    .join("");
  renderItems();
}
function setFilter(f) {
  state.filterTab = f;
  renderHome();
}
function onSearchInput() {
  state.search = document.getElementById("searchInput").value;
  document.getElementById("searchClear").style.display = state.search
    ? "block"
    : "none";
  renderItems();
}
function clearSearch() {
  state.search = "";
  document.getElementById("searchInput").value = "";
  document.getElementById("searchClear").style.display = "none";
  renderItems();
}
function renderItems() {
  var container = document.getElementById("itemsContainer");
  var items = state.items.slice();
  var s = state.search.toLowerCase();
  if (s)
    items = items.filter(function (i) {
      return i.name.toLowerCase().includes(s);
    });
  var f = state.filterTab;
  items = items.filter(function (i) {
    var stat = getStatus(i.expiryDate);
    if (f === "fresh") return stat === "fresh";
    if (f === "soon") return stat === "soon" || stat === "today";
    if (f === "expired") return stat === "expired";
    return true;
  });
  document.getElementById("itemCountLabel").textContent =
    items.length + " " + tr("items");
  if (items.length === 0) {
    container.innerHTML =
      '<div class=\"empty-state\"><div class=\"empty-icon\">' +
      ics("package", 40, 40) +
      "</div><h3>" +
      tr("noItems") +
      "</h3><p>" +
      tr("addFirst") +
      '</p><button class=\"empty-cta\" onclick=\"openAddItem()\">' +
      ics("plus", 16, 16) +
      " " +
      tr("addFirst") +
      "</button></div>";
    return;
  }
  container.innerHTML = items
    .map(function (item) {
      var stat = getStatus(item.expiryDate);
      var c = {
        fresh: "#22C55E",
        soon: "#F59E0B",
        today: "#EF4444",
        expired: "#DC2626",
      }[stat];
      var bg = {
        fresh: state.isDark ? "#0D2818" : "#DCFCE7",
        soon: state.isDark ? "#2A1F06" : "#FEF9C3",
        today: state.isDark ? "#2A0F06" : "#FEE2E2",
        expired: state.isDark ? "#1A0A0A" : "#FECACA",
      }[stat];
      var dl = daysLeft(item.expiryDate);
      var dlKnown = isNaN(dl);
      var badge =
        stat === "expired"
          ? dlKnown
            ? tr("expired")
            : fmt(tr("daysAgoTpl"), { n: Math.abs(dl) })
          : stat === "today"
            ? tr("expiresToday")
            : dlKnown
              ? tr("expired")
              : dl === 1
                ? tr("expiresTomorrow")
                : fmt(tr("daysLeftTpl"), { n: dl });
      var ci =
        item.category && CAT_ICON[item.category]
          ? CAT_ICON[item.category]
          : "package";
      var priceStr =
        item.price != null && item.price > 0 ? "₹" + item.price : "";
      return (
        '<div class=\"item-card\"><div class=\"item-card-inner\"><div class=\"item-card-top\"><div class=\"item-emoji-box\" style=\"background:' +
        c +
        '14\">' +
        (item.photoBase64
          ? '<img src=\"' +
            item.photoBase64 +
            '\" style=\"width:50px;height:50px;border-radius:16px;object-fit:cover\">'
          : ics(ci, 26, 26)) +
        '</div><div class="item-info"><div class="item-name">' +
        esc(item.name) +
        '</div><div class="item-meta">' +
        ics(ci, 10, 10) +
        " " +
        esc(catLabel(item.category)) +
        " &bull; " +
        item.quantity +
        " " +
        item.unit +
        '</div></div><div class=\"item-right\"><div class=\"item-price\">' +
        (priceStr || "") +
        '</div><div class=\"item-badge\" style=\"background:' +
        bg +
        ";color:" +
        c +
        '\">' +
        badge +
        '</div></div></div><div class=\"item-card-actions\"><button onclick=\"editItem(' +
        item.id +
        ')\">' +
        ics("edit", 14, 14) +
        " " +
        tr("editItem") +
        '</button><button onclick=\"duplicateItem(' +
        item.id +
        ')\">' +
        ics("copy", 14, 14) +
        ' Duplicate</button><button onclick=\"consumeItem(' +
        item.id +
        ')\">' +
        ics("check", 14, 14) +
        " " +
        tr("enjoy").split("!")[0] +
        '</button><button aria-label=\"Delete\" onclick=\"deleteItem(' +
        item.id +
        ')\" style=\"color:#EF4444\">' +
        ics("trash2", 14, 14) +
        "</button></div></div>"
      );
    })
    .join("");
}
function deleteItem(id) {
  state.items = state.items.filter(function (i) {
    return i.id !== id;
  });
  save();
  renderHome();
  showToast(tr("itemRemoved"));
}
function consumeItem(id) {
  state.items = state.items.filter(function (i) {
    return i.id !== id;
  });
  save();
  renderHome();
  showToast(tr("enjoy"));
}
function duplicateItem(id) {
  var orig = state.items.find(function (i) {
    return i.id === id;
  });
  if (!orig) return;
  var copy = Object.assign({}, orig, {
    id: nextItemId++,
    name: orig.name + " (Copy)",
  });
  state.items.push(copy);
  save();
  renderHome();
  showToast(tr("duplicated"));
}
function editItem(id) {
  state.editingItemId = id;
  openAddItem();
}
function openAddItem() {
  var isEdit = state.editingItemId != null;
  var item = isEdit
    ? state.items.find(function (i) {
        return i.id === state.editingItemId;
      })
    : null;
  var cats = [
    "fruits_veg",
    "dairy_eggs",
    "bakery_bread",
    "meat_seafood",
    "pantry_grains",
    "beverages",
    "others",
  ];
  var defCat = item ? item.category : "fruits_veg";
  var defUnit = item ? item.unit : "kg";
  document.getElementById("addItemModal").classList.add("show");
  setOverlayLock(true);
  var c = document.getElementById("addItemContent");
  c.innerHTML =
    '<div class=\"modal-handle\"></div><div class=\"modal-title\">' +
    ics("package", 22, 22) +
    " " +
    (isEdit ? tr("editItem") : tr("addItem")) +
    '</div><div class=\"modal-sub\">' +
    (isEdit ? tr("refineDetails") : tr("captureIngredients")) +
    '</div><div id=\"addFormError\" style=\"display:none\" class=\"form-error\"></div><div class=\"form-group\"><label class=\"form-label\">' +
    ics("camera", 12, 12) +
    " " +
    tr("photo") +
    '</label><div style=\"display:flex;align-items:center;gap:12px\"><div style=\"width:80px;height:80px;border-radius:20px;border:2px dashed #00C897;display:flex;align-items:center;justify-content:center;cursor:pointer;background:' +
    (state.isDark ? "#1C2D28" : "#F3FDF5") +
    '\" onclick=\"document.getElementById(\'photoInput\').click()\" id=\"photoPreview\">' +
    (item && item.photoBase64
      ? '<img src=\"' +
        item.photoBase64 +
        '\" style=\"width:76px;height:76px;border-radius:18px;object-fit:cover\">'
      : ics("camera", 28, 28)) +
    '</div><div><button style=\"padding:8px 12px;border-radius:12px;border:1.5px solid #00C897;background:rgba(0,200,151,.12);color:#00C897;font-size:10px;font-weight:700;cursor:pointer\" onclick=\"document.getElementById(\'photoInput\').click()\">' +
    ics("camera", 12, 12) +
    " " +
    tr("choosePhoto") +
    '</button><p style=\"font-size:9px;color:#4A6F62;margin-top:4px\">' +
    tr("savedLocally") +
    '</p></div><input type=\"file\" id=\"photoInput\" accept=\"image/*\" style=\"display:none\" onchange=\"handlePhoto(event)\"></div></div><div class=\"form-group\"><label class=\"form-label\">' +
    ics("tag", 12, 12) +
    " " +
    tr("category") +
    '</label><div class=\"category-chips\" id=\"catChips\">' +
    cats
      .map(function (c) {
        return (
          '<div class=\"cat-chip' +
          (defCat === c ? " active" : "") +
          '\" onclick=\"selectCat(\'' +
          c +
          "')\">" +
          ics(CAT_ICON[c] || "package", 14, 14) +
          " " +
          catLabel(c) +
          "</div>"
        );
      })
      .join("") +
    '</div></div><div class=\"form-group\"><label class=\"form-label\">' +
    ics("edit", 12, 12) +
    " " +
    tr("itemName") +
    '</label><input class=\"form-input\" id=\"fName\" placeholder=\"' +
    tr("itemNamePh") +
    '\" value=\"' +
    (item ? item.name : "") +
    '\"></div><div class=\"form-group\"><label class=\"form-label\">' +
    ics("sliders", 12, 12) +
    " " +
    tr("qtyUnit") +
    '</label><div class=\"form-row\"><input class=\"form-input\" id=\"fQty\" type=\"number\" value=\"' +
    (item ? item.quantity : 1) +
    '\" min=\"0.5\" step=\"0.5\"><div style=\"position:relative\"><div class=\"cat-chip\" onclick=\"toggleFUnitDropdown()\" id=\"fUnitLabel\">' +
    defUnit +
    ' <span class=\"icon\" style=\"width:12px;height:12px\">' +
    ICONS.chevronDown +
    '</span></div><div class=\"sl-unit-dropdown\" id=\"fUnitDropdown\">' +
    UNITS.map(function (u) {
      return (
        '<div class=\"sl-unit-opt\" onclick=\"selectUnit(\'' +
        u +
        "')\">" +
        u +
        "</div>"
      );
    }).join("") +
    '</div></div></div></div><div class=\"form-group\"><label class=\"form-label\">₹ ' +
    tr("price") +
    '</label><input class=\"form-input\" id=\"fPrice\" type=\"number\" placeholder=\"0.00\" value=\"' +
    (item && item.price ? item.price : "") +
    '\" min=\"0\" step=\"1\"></div><div class=\"form-group\"><label class=\"form-label\">' +
    ics("clock", 12, 12) +
    " " +
    tr("purchaseDate") +
    '</label><input class=\"form-input\" id=\"fBought\" type=\"date\" value=\"' +
    (item ? item.boughtDate : todayStr) +
    '\"></div><div class=\"form-group\"><label class=\"form-label\">' +
    ics("alertTriangle", 12, 12) +
    " " +
    tr("expiryDate") +
    '</label><input class=\"form-input\" id=\"fExpiry\" type=\"date\" value=\"' +
    (item ? item.expiryDate : "") +
    '\"></div><div class=\"form-group\"><label class=\"form-label\">' +
    ics("file", 12, 12) +
    " " +
    tr("notes") +
    '</label><input class=\"form-input\" id=\"fNotes\" placeholder=\"' +
    tr("notesPh") +
    '\" value=\"' +
    (item ? item.notes : "") +
    '\"></div><div class=\"modal-actions\"><button class=\"btn-cancel\" onclick=\"closeAddItem()\">' +
    tr("cancel") +
    '</button><button class=\"btn-primary\" onclick=\"saveItem()\">' +
    (isEdit ? tr("saveItem") : tr("addItem")) +
    "</button></div>";
}
function selectCat(c) {
  window._selCat = c;
  document.querySelectorAll("#catChips .cat-chip").forEach(function (el) {
    el.classList.toggle("active", el.textContent.includes(catLabel(c)));
  });
}
function selectUnit(u) {
  window._selUnit = u;
  document.getElementById("fUnitLabel").innerHTML =
    u +
    ' <span class=\"icon\" style=\"width:12px;height:12px\">' +
    ICONS.chevronDown +
    "</span>";
  var dud = document.getElementById("fUnitDropdown");
  if (dud) dud.classList.remove("show");
}
function toggleFUnitDropdown() {
  var d = document.getElementById("fUnitDropdown");
  if (d) d.classList.toggle("show");
}
function handlePhoto(e) {
  var file = e.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function (ev) {
    window._photo = ev.target.result;
    var p = document.getElementById("photoPreview");
    p.innerHTML =
      '<img src=\"' +
      ev.target.result +
      '\" style=\"width:76px;height:76px;border-radius:18px;object-fit:cover\">';
  };
  reader.readAsDataURL(file);
}
function closeAddItem() {
  document.getElementById("addItemModal").classList.remove("show");
  setOverlayLock(false);
  state.editingItemId = null;
}
function saveItem() {
  var isEdit = state.editingItemId != null;
  var name = document.getElementById("fName").value.trim();
  var cat = window._selCat || "fruits_veg";
  var qty = parseFloat(document.getElementById("fQty").value) || 1;
  var unit = window._selUnit || "kg";
  var price = parseFloat(document.getElementById("fPrice").value) || null;
  if (price === 0) price = null;
  var bought = document.getElementById("fBought").value;
  var expiry = document.getElementById("fExpiry").value;
  var notes = document.getElementById("fNotes").value.trim();
  var photo = window._photo || null;
  if (!name) {
    var fe = document.getElementById("addFormError");
    fe.style.display = "block";
    fe.innerHTML = ics("alertTriangle", 14, 14) + " " + tr("nameRequired");
    return;
  }
  if (!expiry) {
    var fe = document.getElementById("addFormError");
    fe.style.display = "block";
    fe.innerHTML = ics("alertTriangle", 14, 14) + " " + tr("expiryRequired");
    return;
  }
  document.getElementById("addFormError").style.display = "none";
  if (isEdit) {
    var idx = state.items.findIndex(function (i) {
      return i.id === state.editingItemId;
    });
    if (idx >= 0)
      state.items[idx] = {
        id: state.editingItemId,
        name: name,
        category: cat,
        quantity: qty,
        unit: unit,
        price: price,
        boughtDate: bought,
        expiryDate: expiry,
        notes: notes,
        photoBase64: photo,
      };
  } else {
    state.items.push({
      id: nextItemId++,
      name: name,
      category: cat,
      quantity: qty,
      unit: unit,
      price: price,
      boughtDate: bought,
      expiryDate: expiry,
      notes: notes,
      photoBase64: photo,
    });
  }
  save();
  closeAddItem();
  state.editingItemId = null;
  renderHome();
  showToast(isEdit ? tr("itemUpdated") : tr("itemSaved"));
}
/* ============================================================
   FRESHTRACK SHOPPING MODULE - REDESIGNED (2026)
   Professional grocery planner: cards, sheets, gestures, dnd,
   templates, search/filter, FAB quick actions. Offline-first.
   ============================================================ */

var _slFilter = "all";
var _slSearch = "";
var _slListUndo = null;
var _slItemUndo = null;
var _swipeSuppress = false;

function showUndoToast(msg, undoFn) {
  var c = document.getElementById("toastContainer");
  if (!c) return;
  var t = document.createElement("div");
  t.className = "toast sl-undo-toast";
  var span = document.createElement("span");
  span.textContent = msg;
  var btn = document.createElement("button");
  btn.className = "sl-undo-btn";
  btn.textContent = tr("undo");
  btn.onclick = function () {
    t.remove();
    undoFn();
  };
  t.appendChild(span);
  t.appendChild(btn);
  c.appendChild(t);
  setTimeout(function () {
    t.style.opacity = "0";
    t.style.transition = "opacity .3s";
    setTimeout(function () {
      t.remove();
    }, 300);
  }, 4000);
}

