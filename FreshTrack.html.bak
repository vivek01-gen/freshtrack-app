function curSym() {
  var syms = { INR: "₹", USD: "$", EUR: "€", GBP: "£", JPY: "¥", CNY: "¥" };
  return syms[state.currency] || "₹";
}
function slNorm(sl) {
  if (!sl) return sl;
  sl.items = sl.items || [];
  sl.title = sl.title || tr("shoppingList");
  sl.icon = sl.icon || "shoppingBag";
  sl.color = sl.color || "green";
  sl.budget = sl.budget || null;
  sl.createdAt = sl.createdAt || Date.now();
  sl.modifiedAt = sl.modifiedAt || sl.createdAt;
  sl.totalExpense = sl.totalExpense || 0;
  sl.isCompleted = !!sl.isCompleted;
  sl.completedAt = sl.completedAt || 0;
  sl.archived = !!sl.archived;
  sl.favorited = !!sl.favorited;
  sl.pinned = !!sl.pinned;
  sl.shared = !!sl.shared;
  sl.order = sl.order || 0;
  sl.note = sl.note || "";
  sl.items.forEach(function (it) {
    slItemNorm(it);
  });
  return sl;
}
function slItemNorm(it) {
  it.qty = it.qty || 1;
  it.unit = it.unit || "pieces";
  it.price = it.price || 0;
  it.notes = it.notes || "";
  it.category = it.category || "others";
  it.priority = it.priority || 0;
  it.checked = !!it.checked;
  it.favorited = !!it.favorited;
  it.addedAt = it.addedAt || Date.now();
  it.store = it.store || "";
  it.brand = it.brand || "";
  it.photo = it.photo || null;
  it.voice = it.voice || null;
  it.reminder = it.reminder || null;
  it.order = it.order || 0;
  return it;
}
function normalizeShoppingData() {
  (state.shoppingLists || []).forEach(slNorm);
  state.shoppingLists.forEach(function (sl, i) {
    if (!sl.order) sl.order = i;
  });
}
function getSL(id) {
  return (state.shoppingLists || []).find(function (s) {
    return s.id === id;
  });
}
function slTotal(items) {
  return items.reduce(function (a, i) {
    return a + (i.price || 0) * i.qty;
  }, 0);
}
function slSaveList(sl) {
  sl.modifiedAt = Date.now();
  sl.totalExpense = slTotal(sl.items || []);
  save();
  renderShopping();
}
function trackRecent(name) {
  if (!name) return;
  var r = state.recentItems;
  r = r.filter(function (x) {
    return x !== name;
  });
  r.unshift(name);
  if (r.length > 20) r.length = 20;
  state.recentItems = r;
  save();
}
function isDuplicate(sl, name) {
  return (
    sl.items &&
    sl.items.some(function (i) {
      return i.name.toLowerCase() === name.toLowerCase();
    })
  );
}
function slDate(ts) {
  var d = new Date(ts);
  var dd = String(d.getDate()).padStart(2, "0");
  var mm = String(d.getMonth() + 1).padStart(2, "0");
  var yyyy = d.getFullYear();
  if (state.dateFormat === "MM/DD/YYYY") return mm + "/" + dd + "/" + yyyy;
  if (state.dateFormat === "YYYY-MM-DD") return yyyy + "-" + mm + "-" + dd;
  if (state.dateFormat === "DD.MM.YYYY") return dd + "." + mm + "." + yyyy;
  return dd + "/" + mm + "/" + yyyy;
}
function slTimeAgo(ts) {
  if (!ts) return "";
  var days = Math.floor((Date.now() - ts) / 86400000);
  if (days <= 0) return tr("today");
  if (days === 1) return tr("yesterday");
  return fmt(tr("daysAgoTpl"), { n: days });
}
function slDone(sl) {
  if (!sl) return;
  sl.modifiedAt = Date.now();
  sl.totalExpense = slTotal(sl.items || []);
  save();
}
function openShoppingList(id) {
  state.activeListId = id;
  renderShopping();
}
function closeShoppingList() {
  state.activeListId = null;
  renderShopping();
}
function slOpenById(id) {
  openShoppingList(id);
}

/* ---------------- LIST VIEW ---------------- */
function renderShopping() {
  applyTheme();
  refreshUI();
  setTimeout(function () {
    var sc = document.getElementById("shoppingScroll");
    if (sc) sc.scrollTo(0, 0);
  }, 10);
  ["shoppingShareBar", "shoppingSummary", "shoppingBottomActions"].forEach(
    function (id) {
      var el = document.getElementById(id);
      if (el) el.style.display = "none";
    },
  );
  var fab = document.getElementById("shopFab");
  if (fab) fab.style.display = "block";
  var c = document.getElementById("shoppingContent");
  if (!c) return;
  if (state.activeListId) {
    if (fab) fab.style.display = "none";
    renderShoppingDetail();
    return;
  }
  renderShoppingToolbar();
  c.innerHTML = "";
  var all = state.shoppingLists.slice();
  normalizeShoppingData();
  all = state.shoppingLists.slice();
  var sls = all
    .filter(function (sl) {
      return !sl.archived;
    })
    .filter(function (sl) {
      return slFilterMatch(sl);
    })
    .sort(function (a, b) {
      if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
      if (_slFilter === "alphabetical")
        return (a.title || "").localeCompare(b.title || "");
      if (_slFilter === "recent")
        return (b.modifiedAt || b.createdAt) - (a.modifiedAt || a.createdAt);
      return (b.modifiedAt || b.createdAt) - (a.modifiedAt || a.createdAt);
    });
  c.innerHTML +=
    '<div class="sl-dheader"><div><div class="sl-dtitle">' +
    ics("shoppingBag", 22, 22) +
    " " +
    tr("myLists") +
    '</div></div><button class="sl-dcreate" onclick="slNewList()">' +
    ics("plus", 14, 14) +
    " " +
    tr("create") +
    "</button></div>";
  if (sls.length === 0 && (state.shoppingLists || []).length === 0) {
    c.innerHTML += slEmptyState();
    return;
  }
  if (sls.length === 0) {
    c.innerHTML +=
      '<div class="sl-nofilter">' +
      ics("search", 28, 28) +
      "<div>" +
      tr("noFilterResults") +
      "</div></div>";
    return;
  }
  c.innerHTML += '<div id="slListWrap"></div>';
  sls.forEach(function (sl) {
    c.querySelector("#slListWrap").innerHTML += slCard(sl);
  });
  attachCardInteractions();
}
function slFilterMatch(sl) {
  if (_slSearch) {
    var q = _slSearch.toLowerCase();
    var hit =
      (sl.title || "").toLowerCase().indexOf(q) >= 0 ||
      (sl.items || []).some(function (it) {
        return (it.name || "").toLowerCase().indexOf(q) >= 0;
      });
    if (!hit) return false;
  }
  if (_slFilter === "completed" && !sl.isCompleted) return false;
  if (_slFilter === "incomplete" && sl.isCompleted) return false;
  if (_slFilter === "favorite" && !sl.favorited) return false;
  if (_slFilter === "archived" && !sl.archived) return false;
  if (_slFilter === "shared" && !sl.shared) return false;
  return true;
}
function renderShoppingToolbar() {
  var tb = document.getElementById("shoppingToolbar");
  if (!tb) return;
  tb.style.display = "block";
  var chips = [
    ["all", "all"],
    ["completed", "completed"],
    ["incomplete", "incomplete"],
    ["favorite", "favorite"],
    ["archived", "archived"],
    ["shared", "shared"],
    ["recent", "recent"],
    ["alphabetical", "alphabetical"],
  ];
  var html =
    '<div class="sl-toolbar-row"><span class="sl-toolbar-search-icon">' +
    ics("search", 14, 14) +
    '</span><input class="sl-toolbar-search" id="slSearchInput" placeholder="' +
    tr("searchLists") +
    '" value="' +
    esc(_slSearch) +
    '" oninput="slSearchOnInput(this.value)" onkeydown="if(event.key===\'Enter\')this.blur()"></div>';
  html += '<div class="sl-chips">';
  chips.forEach(function (chip) {
    html +=
      '<button class="sl-chip' +
      (_slFilter === chip[0] ? " active" : "") +
      '" onclick="slSetFilter(\'' +
      chip[0] +
      "')\">" +
      tr(chip[1]) +
      "</button>";
  });
  html += "</div>";
  tb.innerHTML = html;
}
function slSearchOnInput(v) {
  _slSearch = v.trim();
  renderShopping();
}
function slSetFilter(f) {
  _slFilter = f;
  renderShopping();
}
function slCard(sl) {
  var items = sl.items || [];
  var total = items.length;
  var purchased = items.filter(function (i) {
    return i.checked;
  }).length;
  var remaining = total - purchased;
  var pct = total > 0 ? Math.round((purchased / total) * 100) : 0;
  var sum = slTotal(items);
  var color = LIST_COLOR_VALUES[sl.color] || "#22C55E";
  var pinBadge = sl.pinned ? ics("pin", 14, 14) : "";
  var favBadge = sl.favorited ? ics("star2", 14, 14) : "";
  var actions = slCardActions(sl.id);
  var drag =
    '<span class="sl-drag-handle" draggable="true" data-id="' +
    sl.id +
    '" title="' +
    tr("dragToReorder") +
    '">' +
    ics("grip", 14, 14) +
    "</span>";
  return (
    '<div class="sl-card-wrap" id="slCardWrap_' +
    sl.id +
    '"><div class="sl-card-bg bg-left">' +
    '<button class="sl-bg-act" aria-label="' +
    tr("complete") +
    '" onclick="slCompleteNow(' +
    sl.id +
    ')" title="' +
    tr("complete") +
    '">' +
    ics("check", 18, 18) +
    "<span>" +
    tr("complete") +
    "</span></button>" +
    '<button class="sl-bg-act" aria-label="' +
    tr("favorite") +
    '" onclick="slFavorite(' +
    sl.id +
    ')" title="' +
    tr("favorite") +
    '">' +
    ics("heart", 18, 18) +
    "<span>" +
    tr("favorite") +
    "</span></button>" +
    '<button class="sl-bg-act" aria-label="' +
    tr("pin") +
    '" onclick="slPin(' +
    sl.id +
    ')" title="' +
    tr("pin") +
    '">' +
    ics("pin", 18, 18) +
    "<span>" +
    tr("pin") +
    "</span></button></div>" +
    '<div class="sl-card-bg bg-right">' +
    '<button class="sl-bg-act danger" aria-label="' +
    tr("archive") +
    '" onclick="slArchiveById(' +
    sl.id +
    ')" title="' +
    tr("archive") +
    '">' +
    ics("archive", 18, 18) +
    "<span>" +
    tr("archive") +
    "</span></button>" +
    '<button class="sl-bg-act danger" aria-label="' +
    tr("delete") +
    '" onclick="slDeleteById(' +
    sl.id +
    ')" title="' +
    tr("delete") +
    '">' +
    ics("trash2", 18, 18) +
    "<span>" +
    tr("delete") +
    "</span></button></div>" +
    '<div class="sl-card" id="slCard_' +
    sl.id +
    '" onclick="slCardTap(' +
    sl.id +
    ')" style="--slcolor:' +
    color +
    '">' +
    '<div class="sl-card-top"><div class="sl-ico" style="background:' +
    color +
    "1c;color:" +
    color +
    '">' +
    ics(sl.icon || "shoppingBag", 22, 22) +
    '</div><div class="sl-card-name">' +
    esc(sl.title) +
    '<div class="sl-card-tags">' +
    (sl.isCompleted
      ? '<span class="sl-mini-tag" style="background:' +
        color +
        "22;color:" +
        color +
        '">' +
        tr("completed") +
        "</span>"
      : "") +
    (sl.shared
      ? '<span class="sl-mini-tag">' +
        ics("users", 10, 10) +
        " " +
        tr("shared") +
        "</span>"
      : "") +
    "</div></div>" +
    '<div class="sl-card-badges">' +
    pinBadge +
    favBadge +
    "</div>" +
    '<div class="sl-card-arrow">' +
    ics("chevronRight", 18, 18) +
    "</div></div>" +
    '<div class="sl-card-progress"><div class="sl-progress-track"><div class="sl-progress-fill" style="width:' +
    pct +
    "%;background:" +
    color +
    '"></div></div><span class="sl-progress-pct">' +
    pct +
    "%</span></div>" +
    '<div class="sl-card-metrics">' +
    '<div class="sl-metric"><div class="sl-metric-val">' +
    total +
    '</div><div class="sl-metric-lbl">' +
    tr("totalItems") +
    "</div></div>" +
    '<div class="sl-metric"><div class="sl-metric-val" style="color:' +
    color +
    '">' +
    purchased +
    '</div><div class="sl-metric-lbl">' +
    tr("purchased") +
    "</div></div>" +
    '<div class="sl-metric"><div class="sl-metric-val">' +
    remaining +
    '</div><div class="sl-metric-lbl">' +
    tr("remaining") +
    "</div></div>" +
    '<div class="sl-metric"><div class="sl-metric-val">' +
    curSym() +
    sum.toFixed(0) +
    '</div><div class="sl-metric-lbl">' +
    tr("totalCost") +
    "</div></div></div>" +
    '<div class="sl-card-dates"><span>' +
    ics("clock", 12, 12) +
    " " +
    tr("lastUpdated") +
    ": " +
    slTimeAgo(sl.modifiedAt || sl.createdAt) +
    "</span><span>" +
    ics("calendar", 12, 12) +
    " " +
    tr("createdOn") +
    ": " +
    slDate(sl.createdAt || Date.now()) +
    "</span></div>" +
    '<div class="sl-card-actions">' +
    actions +
    drag +
    "</div>" +
    "</div></div>"
  );
}
function slCardActions(id) {
  var defs = [
    ["open", "slOpenById(" + id + ")", "chevronRight"],
    ["rename", "slRename(" + id + ")", "edit"],
    ["edit", "slEditList(" + id + ")", "edit"],
    ["duplicate", "slDuplicate(" + id + ")", "copy"],
    ["archive", "slArchiveById(" + id + ")", "archive"],
    ["share", "slShareList(" + id + ")", "share"],
    ["export", "slExportList(" + id + ")", "download"],
    ["delete", "slDeleteById(" + id + ")", "trash2"],
    ["favorite", "slFavorite(" + id + ")", "star"],
    ["pin", "slPin(" + id + ")", "pin"],
  ];
  var html = "";
  defs.forEach(function (d) {
    html +=
      '<button class="sl-card-act" aria-label="' +
      tr(d[0]) +
      '" title="' +
      tr(d[0]) +
      '" onclick="event.stopPropagation();' +
      d[1] +
      '">' +
      ics(d[2], 14, 14) +
      '<span class="sl-act-tip">' +
      tr(d[0]) +
      "</span></button>";
  });
  return html;
}
function slCardTap(id) {
  if (_swipeSuppress) return;
  openShoppingList(id);
}
function slEmptyState() {
