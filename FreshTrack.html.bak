    SL_TEMPLATES.slice(0, 4)
      .map(function (tpl) {
        return (
          '<button class="sl-chip" onclick="slNewFromTemplate(\'' +
          tpl.id +
          "')\">" +
          ics(tpl.icon, 12, 12) +
          " " +
          tr(tpl.name) +
          "</button>"
        );
      })
      .join("") +
    "</div></div></div>"
  );
}
function slNewList() {
  var iconChoices = [
    "shoppingBag",
    "cart",
    "leaf",
    "package",
    "star",
    "truck",
    "box",
    "grid",
  ]
    .map(function (ic) {
      return (
        '<button class="sl-pick-ico' +
        (ic === "shoppingBag" ? " active" : "") +
        '" data-ic="' +
        ic +
        '" onclick="slPickIcon(this,\'' +
        ic +
        "')\">" +
        ics(ic, 18, 18) +
        "</button>"
      );
    })
    .join("");
  var colorChoices = LIST_COLORS.map(function (cc) {
    var v = LIST_COLOR_VALUES[cc];
    return (
      '<button class="sl-pick-color' +
      (cc === "green" ? " active" : "") +
      '" data-c="' +
      cc +
      '" style="background:' +
      v +
      '" onclick="slPickColor(this,\'' +
      cc +
      "')\">" +
      (cc === "green" ? ics("check", 12, 12) : "") +
      "</button>"
    );
  }).join("");
  showDialog(
    tr("createList"),
    '<div class="sl-newform">' +
      '<div class="sl-new-label">' +
      tr("icon") +
      '</div><div class="sl-pick-icos">' +
      iconChoices +
      "</div>" +
      '<div class="sl-new-label">' +
      tr("colorLabel") +
      '</div><div class="sl-pick-colors">' +
      colorChoices +
      "</div>" +
      '<div class="sl-new-label">' +
      tr("name") +
      '</div><input id="newListName" class="form-input" placeholder="' +
      tr("listTitlePh") +
      '"><input id="newListBudget" class="form-input" type="number" placeholder="' +
      tr("budgetOptional") +
      '" style="margin-top:8px">' +
      '<div class="sl-new-label">' +
      tr("template") +
      '</div><div class="sl-tpl-chips">' +
      SL_TEMPLATES.map(function (tpl) {
        return (
          '<button class="sl-chip" onclick="slNewFromTemplate(\'' +
          tpl.id +
          "')\">" +
          ics(tpl.icon, 12, 12) +
          " " +
          tr(tpl.name) +
          "</button>"
        );
      }).join("") +
      "</div></div>",
    [
      { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
      {
        label: tr("create"),
        cls: "btn-primary",
        fn: function () {
          var nm =
            document.getElementById("newListName").value.trim() ||
            tr("shoppingList") + " " + (Date.now() % 1000);
          var bg =
            parseFloat(document.getElementById("newListBudget").value) || 0;
          var ic = "shoppingBag";
          var pick = document.querySelector(".sl-pick-ico.active");
          if (pick) ic = pick.getAttribute("data-ic");
          var col = "green";
          var pickC = document.querySelector(".sl-pick-color.active");
          if (pickC) col = pickC.getAttribute("data-c");
          state.shoppingLists.push(
            slNorm({
              id: nextListId++,
              title: nm,
              budget: bg > 0 ? bg : null,
              items: [],
              createdAt: Date.now(),
              modifiedAt: Date.now(),
              totalExpense: 0,
              isCompleted: false,
              completedAt: 0,
              archived: false,
              favorited: false,
              pinned: false,
              shared: false,
              icon: ic,
              color: col,
              order: state.shoppingLists.length,
            }),
          );
          save();
          renderShopping();
          showToast(tr("listCreated"));
        },
      },
    ],
  );
}
function slPickIcon(btn, ic) {
  document.querySelectorAll(".sl-pick-ico").forEach(function (b) {
    b.classList.remove("active");
  });
  btn.classList.add("active");
}
function slPickColor(btn, c) {
  document.querySelectorAll(".sl-pick-color").forEach(function (b) {
    b.classList.remove("active");
    if (b.querySelector(".icon")) b.querySelector(".icon").remove();
  });
  btn.classList.add("active");
  btn.insertAdjacentHTML("beforeend", ics("check", 12, 12));
}
function slNewFromTemplate(tid) {
  var tpl = SL_TEMPLATES.find(function (t) {
    return t.id === tid;
  });
  if (!tpl) return;
  var ov = document.getElementById("dialogOverlay");
  if (ov && ov.classList.contains("show")) closeDialog();
  var sl = slNorm({
    id: nextListId++,
    title: tr(tpl.name),
    icon: tpl.icon,
    color: tpl.color,
    budget: null,
    items: [],
    createdAt: Date.now(),
    modifiedAt: Date.now(),
    totalExpense: 0,
    isCompleted: false,
    completedAt: 0,
    archived: false,
    favorited: false,
    pinned: false,
    shared: false,
    order: state.shoppingLists.length,
  });
  tpl.items.forEach(function (t) {
    sl.items.push(
      slItemNorm({
        id: nextShopItemId++,
        name: t.name,
        qty: t.qty,
        unit: t.unit,
        price: t.price,
        category: t.category,
      }),
    );
  });
  state.shoppingLists.push(sl);
  save();
  renderShopping();
  showToast(tr("listCreated"));
}
function slEditList(id) {
  slRename(id);
}
function slRename(id) {
  var sl = getSL(id);
  if (!sl) return;
  showDialog(
    tr("rename"),
    '<input id="renameInput" class="form-input" value="' + esc(sl.title) + '">',
    [
      { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
      {
        label: tr("save"),
        cls: "btn-primary",
        fn: function () {
          var v = document.getElementById("renameInput").value.trim();
          if (v) {
            sl.title = v;
            slDone(sl);
            renderShopping();
          }
        },
      },
    ],
  );
}
function slFavorite(id) {
  var sl = getSL(id);
  if (!sl) return;
  sl.favorited = !sl.favorited;
  slDone(sl);
  renderShopping();
  showToast(sl.favorited ? tr("listFavorited") : tr("listUnfavorited"));
}
function slPin(id) {
  var sl = getSL(id);
  if (!sl) return;
  sl.pinned = !sl.pinned;
  slDone(sl);
  renderShopping();
  showToast(sl.pinned ? tr("listPinned") : tr("listUnpinned"));
}
function slDuplicate(id) {
  var src = getSL(id);
  if (!src) return;
  var copy = JSON.parse(JSON.stringify(src));
  copy.id = nextListId++;
  copy.title = src.title + " (" + tr("copy") + ")";
  copy.createdAt = Date.now();
  copy.modifiedAt = Date.now();
  copy.archived = false;
  copy.isCompleted = false;
  copy.completedAt = 0;
  copy.order = state.shoppingLists.length;
  copy.items.forEach(function (it) {
    it.id = nextShopItemId++;
  });
  state.shoppingLists.push(slNorm(copy));
  save();
  renderShopping();
  showToast(tr("listDuplicated"));
}
function slArchiveById(id) {
  var sl = getSL(id);
  if (!sl) return;
  sl.archived = true;
  slDone(sl);
  renderShopping();
  showToast(tr("archived"));
}
function slDeleteById(id) {
  var sl = getSL(id);
  if (!sl) return;
  showDialog(
    tr("deleteList"),
    fmt(tr("deleteListConfirm"), { list: esc(sl.title) }),
    [
      { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
      {
        label: tr("delete"),
        cls: "btn-danger",
        fn: function () {
          var idx = state.shoppingLists.indexOf(sl);
          if (idx >= 0) state.shoppingLists.splice(idx, 1);
          if (state.activeListId === id) state.activeListId = null;
          _slListUndo = { sl: JSON.parse(JSON.stringify(sl)), idx: idx };
          save();
          renderShopping();
          showUndoToast(tr("listDeleted"), function () {
            slUndoDeleteList();
          });
        },
      },
    ],
  );
}
function slUndoDeleteList() {
  if (!_slListUndo) return;
  var u = _slListUndo;
  state.shoppingLists.splice(u.idx, 0, u.sl);
  _slListUndo = null;
  save();
  renderShopping();
  showToast(tr("restored"));
}
function slShareList(id) {
  var sl = getSL(id);
  if (!sl) return;
  var txt = sl.title + "\n" + slTextItems(sl);
  if (navigator.share) {
    navigator
      .share({ title: tr("appName") + " " + tr("shoppingList"), text: txt })
      .catch(function () {});
  } else {
    navigator.clipboard
      .writeText(txt)
      .then(function () {
        showToast(tr("textCopied"));
      })
      .catch(function () {
        showToast(tr("textCopied"));
      });
  }
}
function slTextItems(sl) {
  return (sl.items || [])
    .map(function (i) {
      return (
        (i.checked ? "[x]" : "[ ] ") +
        i.name +
        " x " +
        (i.qty || 1) +
        " " +
        i.unit +
        (i.price ? " @ " + curSym() + i.price : "")
      );
    })
    .join("\n");
}
function slExportList(id) {
  var sl = getSL(id);
  if (!sl) return;
  var csv =
    tr("itemName") +
    "," +
    tr("category") +
    "," +
    tr("qty") +
    "," +
    tr("unit") +
    "," +
    tr("priceShort") +
    "," +
    tr("notes") +
    "\n";
  (sl.items || []).forEach(function (i) {
    csv +=
      '"' +
      i.name +
      '","' +
      i.category +
      '",' +
      (i.qty || 1) +
      "," +
      i.unit +
      "," +
      (i.price || 0) +
      ',"' +
      (i.notes || "") +
      '"\n';
  });
  var blob = new Blob(["\ufeff" + csv], { type: "text/csv;charset=utf-8" });
  var a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "FreshTrack_" + sl.title.replace(/[^a-z0-9]/gi, "_") + ".csv";
  a.click();
  showToast(tr("csvExported"));
}
function slSetColor(id) {
  var sl = getSL(id);
  if (!sl) return;
  var items = LIST_COLORS.map(function (cc) {
    var v = LIST_COLOR_VALUES[cc];
    return (
      '<button class="sl-color-cell' +
      (sl.color === cc ? " active" : "") +
      '" style="background:' +
      v +
      '" onclick="slApplyColor(' +
      id +
      ",'" +
      cc +
      "')\">" +
      (sl.color === cc ? ics("check", 12, 12) : "") +
      "</button>"
    );
  }).join("");
  showDialog(
    tr("colorLabel"),
    '<div class="sl-color-grid">' + items + "</div>",
    [{ label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} }],
  );
}
function slApplyColor(id, c) {
  var sl = getSL(id);
  if (!sl) return;
  sl.color = c;
  slDone(sl);
  closeDialog();
  renderShopping();
}
function slMoveList(id) {
  var sl = getSL(id);
  if (!sl) return;
  var others = state.shoppingLists.filter(function (o) {
    return o.id !== id && !o.archived;
  });
  var items = others
    .map(function (o) {
      return (
        '<div class="bs-item" onclick="slMoveToList(' +
        id +
        "," +
        o.id +
        ')"><div class="sl-ico" style="width:34px;height:34px">' +
        ics(o.icon || "shoppingBag", 16, 16) +
        '</div><div><div class="lang-native">' +
        esc(o.title) +
        "</div></div></div>"
      );
    })
    .join("");
  showSheet(
    "slMoveOverlay",
    tr("moveTo") + " " + esc(sl.title),
    items ||
      '<div style="padding:16px 20px;font-size:12px;color:var(--muted)">' +
        tr("noOtherLists") +
        "</div>",
  );
}
function slMoveToList(fromId, toId) {
  var from = getSL(fromId);
  var to = getSL(toId);
  if (!from || !to) return;
  var all = from.items;
  from.items = [];
  to.items = to.items.concat(all);
  from.totalExpense = 0;
  to.totalExpense = slTotal(to.items);
  var ov = document.getElementById("slMoveOverlay");
  if (ov) {
    ov.remove();
    setOverlayLock(false);
  }
  save();
  renderShopping();
  showToast(tr("listMoved"));
}
function slCompleteNow(id) {
  state.activeListId = id;
  completeShopping();
}
function attachCardInteractions() {
  document.querySelectorAll(".sl-card-wrap").forEach(function (wrap) {
    var id = wrap.id.replace("slCardWrap_", "");
    var card = document.getElementById("slCard_" + id);
    if (!card) return;
    attachCardSwipe(wrap, card, id);
    attachLongPress(card, function () {
      slCardSheet(parseInt(id, 10));
    });
    var handle = wrap.querySelector(".sl-drag-handle");
    if (handle) attachListDrag(handle, wrap, id);
  });
}
function attachCardSwipe(wrap, card, id) {
  var startX = 0,
    startY = 0,
    dx = 0,
    dy = 0,
    moved = false,
    longT = null;
  var MAX = 96;
  card.addEventListener("touchstart", function (e) {
    var t = e.touches[0];
    startX = t.clientX;
    startY = t.clientY;
    dx = 0;
    dy = 0;
    moved = false;
    card.classList.add("swipe-anim");
  });
  card.addEventListener(
    "touchmove",
    function (e) {
      var t = e.touches[0];
      dx = t.clientX - startX;
      dy = t.clientY - startY;
      if (Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) {
        moved = true;
        e.preventDefault();
        var tx = Math.max(-MAX, Math.min(MAX, dx));
        card.style.transform = "translateX(" + tx + "px)";
      }
    },
    { passive: false },
  );
  card.addEventListener("touchend", function () {
    if (moved) {
      _swipeSuppress = true;
      setTimeout(function () {
        _swipeSuppress = false;
      }, 350);
      if (dx > 60) {
        card.style.transform = "translateX(" + MAX + "px)";
        wrap.classList.add("swiped-right");
      } else if (dx < -60) {
        card.style.transform = "translateX(-" + MAX + "px)";
        wrap.classList.add("swiped-left");
      } else {
        card.style.transform = "translateX(0)";
      }
    } else {
      card.style.transform = "translateX(0)";
    }
  });
  card.addEventListener("click", function () {
    if (
      wrap.classList.contains("swiped-left") ||
      wrap.classList.contains("swiped-right")
    ) {
      wrap.classList.remove("swiped-left", "swiped-right");
      card.style.transform = "translateX(0)";
      if (e) e.stopPropagation();
    }
  });
}
function attachLongPress(el, fn) {
  var t = null;
  el.addEventListener(
    "touchstart",
    function () {
      t = setTimeout(fn, 480);
    },
    { passive: true },
  );
  el.addEventListener(
    "touchmove",
    function () {
      if (t) clearTimeout(t);
      t = null;
    },
    { passive: true },
  );
  el.addEventListener(
    "touchend",
    function () {
      if (t) clearTimeout(t);
      t = null;
    },
    { passive: true },
  );
  el.addEventListener("contextmenu", function (e) {
    e.preventDefault();
    fn();
  });
}
function slCardSheet(id) {
  var sl = getSL(id);
  if (!sl) return;
  var items = [
    ["rename", "slRename(" + id + ")", "edit"],
    ["duplicate", "slDuplicate(" + id + ")", "copy"],
    ["archive", "slArchiveById(" + id + ")", "archive"],
    ["delete", "slDeleteById(" + id + ")", "trash2"],
    ["share", "slShareList(" + id + ")", "share"],
    ["export", "slExportList(" + id + ")", "download"],
    ["colorLabel", "slSetColor(" + id + ")", "palette"],
    ["move", "slMoveList(" + id + ")", "folder"],
    ["favorite", "slFavorite(" + id + ")", "star"],
    ["pin", "slPin(" + id + ")", "pin"],
  ];
  var html = "";
  items.forEach(function (it) {
    html +=
      '<div class="bs-item" onclick="slCloseSheet();' +
      it[1] +
      '">' +
      ics(it[2], 18, 18) +
      '<div><div class="lang-native">' +
      tr(it[0]) +
      "</div></div></div>";
  });
  html +=
    '<div class="bs-item" onclick="slCloseSheet()">' +
    ics("x", 18, 18) +
    '<div><div class="lang-native">' +
    tr("cancel") +
    "</div></div></div>";
  showSheet("slCardOverlay", esc(sl.title), html);
}
function slCloseSheet() {
  [
    "slCardOverlay",
    "slMoveOverlay",
    "slItemOverlay",
    "slFabOverlay",
    "slTplOverlay",
  ].forEach(function (id) {
    var el = document.getElementById(id);
    if (el) el.remove();
  });
  setOverlayLock(false);
}
function attachListDrag(handle, wrap, id) {
  handle.addEventListener("dragstart", function (e) {
    e.dataTransfer.setData("text/plain", String(id));
    handle.classList.add("dragging");
  });
  handle.addEventListener("dragend", function () {
    handle.classList.remove("dragging");
  });
  wrap.addEventListener("dragover", function (e) {
    e.preventDefault();
    wrap.classList.add("drop-over");
  });
  wrap.addEventListener("dragleave", function () {
    wrap.classList.remove("drop-over");
  });
  wrap.addEventListener("drop", function (e) {
    e.preventDefault();
    wrap.classList.remove("drop-over");
    var from = e.dataTransfer.getData("text/plain");
    if (!from || from === id) return;
    slReorderLists(parseInt(from, 10), parseInt(id, 10));
  });
}
function slReorderLists(fromId, toId) {
  var arr = state.shoppingLists.slice();
  var fromI = arr.findIndex(function (s) {
    return s.id === fromId;
  });
  var toI = arr.findIndex(function (s) {
    return s.id === toId;
  });
  if (fromI < 0 || toI < 0) return;
  var item = arr.splice(fromI, 1)[0];
  arr.splice(toI, 0, item);
  state.shoppingLists = arr;
  state.shoppingLists.forEach(function (s, i) {
    s.order = i;
  });
  save();
  renderShopping();
}

/* ---------------- FAB ---------------- */
function slFabOpen() {
  var items = [
    ["newList", "slNewList()", "plus"],
    ["quickItem", "slQuickItem()", "plusCircle"],
    ["import", "slImportShop()", "upload"],
    ["voiceInput", "slVoiceInput()", "mic"],
    ["barcodeScan", "slScan()", "scan"],
    ["templates", "slShowTemplates()", "grid"],
  ];
  var html = "";
  items.forEach(function (it) {
    html +=
      '<div class="bs-item" onclick="slCloseSheet();' +
      it[1] +
      '">' +
      ics(it[2], 18, 18) +
      '<div><div class="lang-native">' +
      tr(it[0]) +
      "</div></div></div>";
  });
  html +=
    '<div class="bs-item" onclick="slCloseSheet()">' +
    ics("x", 18, 18) +
    '<div><div class="lang-native">' +
    tr("cancel") +
    "</div></div></div>";
  showSheet("slFabOverlay", tr("quickActions"), html);
}
function slQuickItem() {
  if (!state.activeListId) return;
  var sl = getSL(state.activeListId);
  if (!sl) return;
  var inp = document.getElementById("slQaName");
  if (inp) {
    inp.focus();
    showToast(tr("quickItem"));
  }
}
function slVoiceInput() {
  var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) {
    showToast(tr("voiceNotSupported"));
    return;
  }
  try {
    var rec = new SR();
    rec.lang = "en-US";
    rec.interimResults = false;
    rec.onresult = function (e) {
      var txt = e.results[0][0].transcript;
      var inp = document.getElementById("slQaName");
      if (inp) inp.value = txt;
      if (state.activeListId) quickAddShop();
      else {
        var inList = document.getElementById("slQaName");
        if (inList) inList.value = txt;
      }
    };
    rec.onerror = function () {
      showToast(tr("voiceError"));
    };
    rec.start();
    showToast(tr("listening"));
  } catch (ex) {
    showToast(tr("voiceError"));
  }
}
function slScan() {
  showToast(tr("barcodeComingSoon"));
}
function slImportShop() {
  document.getElementById("shopCsvInput").click();
}
function slImportShopFile(e) {
  var file = e.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function (ev) {
    try {
      var lines = ev.target.result.split("\n").filter(function (l) {
        return l.trim();
      });
      var target = getSL(state.activeListId);
      if (!target) {
        target = slNorm({
          id: nextListId++,
          title: tr("shoppingList") + " " + (Date.now() % 1000),
          icon: "upload",
          color: "green",
          budget: null,
          items: [],
          createdAt: Date.now(),
          modifiedAt: Date.now(),
          totalExpense: 0,
          order: state.shoppingLists.length,
        });
        state.shoppingLists.push(target);
      }
      var start = lines[0].toLowerCase().includes("name") ? 1 : 0;
      for (var i = start; i < lines.length; i++) {
        var parts = lines[i].split(",");
        var name = (parts[0] || "").replace(/"/g, "").trim();
        if (!name) continue;
        target.items.push(
          slItemNorm({
            id: nextShopItemId++,
            name: name,
            qty: parseFloat(parts[2]) || 1,
            unit: parts[3] ? parts[3].replace(/"/g, "").trim() : "pieces",
            price: parseFloat(parts[4]) || 0,
            category: parts[1]
              ? parts[1].replace(/"/g, "").trim().toLowerCase()
              : "others",
            notes: parts[7] ? parts[7].replace(/"/g, "").trim() : "",
          }),
        );
      }
      slDone(target);
      renderShopping();
      showToast(tr("importSuccess"));
    } catch (ex) {
      showToast(tr("importFailed"));
    }
  };
  reader.readAsText(file);
  e.target.value = "";
}
function slShowTemplates() {
  var html =
    '<div class="sl-tpl-grid">' +
    SL_TEMPLATES.map(function (tpl) {
      return (
        '<button class="sl-tpl-card" onclick="slCloseSheet();slNewFromTemplate(\'' +
        tpl.id +
        "')\">" +
        '<span class="sl-tpl-ico">' +
        ics(tpl.icon, 20, 20) +
        '</span><span class="sl-tpl-name">' +
        tr(tpl.name) +
        "</span></button>"
      );
    }).join("") +
    "</div>";
  showSheet("slTplOverlay", tr("templates"), html);
}

/* ---------------- DETAIL VIEW ---------------- */
function renderShoppingDetail() {
  var sl = getSL(state.activeListId);
  if (!sl) {
    closeShoppingList();
    return;
  }
  var c = document.getElementById("shoppingContent");
  var items = sl.items || [];
  var total = items.length;
  var purchased = items.filter(function (i) {
    return i.checked;
  }).length;
  var remaining = total - purchased;
  var sum = slTotal(items);
  var budget = sl.budget || 0;
  var over = budget > 0 && sum > budget;
  var pct = total > 0 ? Math.round((purchased / total) * 100) : 0;
  var color = LIST_COLOR_VALUES[sl.color] || "#22C55E";
  c.innerHTML =
    '<div class="sl-pheader" style="--slcolor:' +
    color +
    '"><div class="sl-pheader-left"><div class="sl-ico" style="width:44px;height:44px;background:' +
    color +
    "1c;color:" +
    color +
    '">' +
    ics(sl.icon || "shoppingBag", 22, 22) +
    '</div><div><div class="sl-pheader-title">' +
    esc(sl.title) +
    '</div><div class="sl-pheader-sub">' +
    slDate(sl.createdAt || Date.now()) +
    (sl.isCompleted ? " • " + tr("completed") : "") +
    "</div></div></div>" +
    '<div class="sl-pheader-acts"><button class="sl-pheader-btn" aria-label="' +
    tr("complete") +
    '" title="' +
    tr("complete") +
    '" onclick="completeShopping()">' +
    ics("check", 16, 16) +
    '</button><button class="sl-pheader-btn" aria-label="' +
    tr("listActions") +
    '" title="' +
    tr("listActions") +
    '" onclick="slDetailSheet()">' +
    ics("moreHorizontal", 16, 16) +
    "</button></div></div>";
  c.innerHTML += slStatsBar(
    sl,
    total,
    purchased,
    remaining,
    sum,
    budget,
    over,
    pct,
    color,
  );
  c.innerHTML += slAddBar();
  if (total === 0) {
    c.innerHTML += slEmptyDetail(sl, color);
  } else {
    c.innerHTML += '<div id="slItemGroups"></div>';
    document.getElementById("slItemGroups").innerHTML = slItemGroupsHTML(sl);
  }
  c.innerHTML += '<div id="slSummary"></div>';
  renderSLSummary();
  renderDetailShareBar();
  attachItemInteractions(sl);
}
function slStatsBar(
  sl,
  total,
  purchased,
  remaining,
  sum,
  budget,
  over,
  pct,
  color,
) {
  var rows = [
    [tr("totalItems"), total, "package"],
    [tr("purchased"), purchased, "check"],
    [tr("remaining"), remaining, "clock"],
    [tr("estimatedCost"), curSym() + sum.toFixed(2), "tag"],
  ];
  if (budget > 0) {
    rows.push([
      over ? tr("overBudget") : tr("underBudget"),
      curSym() + sum.toFixed(2) + " / " + curSym() + budget.toFixed(0),
      over ? "alertTriangle" : "dollar",
    ]);
  }
  var html = '<div class="sl-stats"><div class="sl-stats-row">';
  rows.forEach(function (r) {
    html +=
      '<div class="sl-stat"><div class="sl-stat-ico">' +
      ics(r[2], 14, 14) +
      '</div><div class="sl-stat-val">' +
      r[1] +
      '</div><div class="sl-stat-lbl">' +
      r[0] +
      "</div></div>";
  });
  html += "</div>";
  if (total > 0) {
    html +=
      '<div class="sl-stats-progress"><div class="sl-progress-track"><div class="sl-progress-fill" style="width:' +
      pct +
      "%;background:" +
      color +
      '"></div></div><span>' +
      pct +
      "% " +
      tr("complete") +
      "</span></div>";
  }
  html += "</div>";
  return html;
}
function slAddBar() {
  return (
    '<div class="sl-add-bar"><div class="sl-add-bar-row"><input class="sl-add-input" id="slQaName" placeholder="' +
    tr("addItemPh") +
    '" onkeydown="if(event.key===\'Enter\')quickAddShop()"><button class="sl-add-btn" aria-label="' +
    tr("addItemBtn") +
    '" onclick="quickAddShop()" type="button">' +
    ics("plus", 18, 18) +
    '</button></div><div class="sl-add-bar-row"><button class="sl-step-btn" aria-label="' +
    tr("decreaseQty") +
    '" onclick="adjustQty(-0.5)" type="button">' +
    ics("minus", 14, 14) +
    '</button><input class="sl-add-qty" id="slQaQty" value="1" type="number" min="0.5" step="0.5"><button class="sl-step-btn" aria-label="' +
    tr("increaseQty") +
    '" onclick="adjustQty(0.5)" type="button">' +
    ics("plus", 14, 14) +
    '</button><div style="position:relative"><button class="sl-unit-btn" aria-label="' +
    tr("unit") +
    '" id="slUnitBtn" onclick="toggleSLUnit()"><span id="slUnitLabel">pieces</span> <span class="icon">' +
    ICONS.chevronDown +
    '</span></button><div class="sl-unit-dropdown" id="slUnitDropdown">' +
    UNITS.map(function (u) {
      return (
        '<div class="sl-unit-opt" onclick="setSLUnit(\'' +
        u +
        "')\">" +
        u +
        "</div>"
      );
    }).join("") +
    '</div></div><input class="sl-add-price" id="slQaPrice" placeholder="' +
    curSym() +
    '" type="number" min="0" step="1" onkeydown="if(event.key===\'Enter\')quickAddShop()"></div></div>'
  );
}
function slEmptyDetail(sl, color) {
  return (
    '<div class="sl-empty small" style="--slcolor:' +
    color +
    '"><div class="sl-empty-art"><div class="sl-empty-bag">' +
    ics(sl.icon || "shoppingBag", 44, 44) +
    "</div>" +
    '<div class="sl-empty-check">' +
    ics("plus", 16, 16) +
    '</div></div><div class="sl-empty-title">' +
    tr("noItems") +
    '</div><div class="sl-empty-sub">' +
    tr("emptyItemsMsg") +
    '</div><div class="sl-tpl-chips" style="justify-content:center">' +
    SL_TEMPLATES.slice(0, 3)
      .map(function (tpl) {
        return (
          '<button class="sl-chip" onclick="slAddTemplateToDetail(\'' +
          tpl.id +
          "')\">" +
          ics(tpl.icon, 12, 12) +
          " " +
          tr(tpl.name) +
          "</button>"
        );
      })
      .join("") +
    "</div></div>"
  );
}
function slAddTemplateToDetail(tid) {
  var tpl = SL_TEMPLATES.find(function (t) {
    return t.id === tid;
  });
  var sl = getSL(state.activeListId);
  if (!tpl || !sl) return;
  tpl.items.forEach(function (t) {
    if (isDuplicate(sl, t.name)) return;
    sl.items.push(
      slItemNorm({
        id: nextShopItemId++,
        name: t.name,
        qty: t.qty,
        unit: t.unit,
        price: t.price,
        category: t.category,
      }),
    );
  });
  slDone(sl);
  renderShoppingDetail();
  showToast(tr("itemsAdded"));
}
function slItemGroupsHTML(sl) {
  var items = (sl.items || []).slice();
  var q = _slSearch.toLowerCase();
  if (q) {
    items = items.filter(function (it) {
      return (
        (it.name || "").toLowerCase().indexOf(q) >= 0 ||
        (it.brand || "").toLowerCase().indexOf(q) >= 0 ||
        (it.store || "").toLowerCase().indexOf(q) >= 0
      );
    });
  }
  if (items.length === 0) {
    return (
      '<div class="sl-nofilter">' +
      ics("search", 28, 28) +
      "<div>" +
      tr("noFilterResults") +
      "</div></div>"
    );
  }
  var groups = {};
  items.forEach(function (it) {
    var g = it.category || "others";
    if (!groups[g]) groups[g] = [];
    groups[g].push(it);
  });
  var order = SL_CATS.filter(function (g) {
    return groups[g];
  });
  var html = "";
  order.forEach(function (g) {
    var glist = groups[g];
    var gdone = glist.filter(function (i) {
      return i.checked;
    }).length;
    var gsum = slTotal(glist);
    html +=
      '<div class="sl-group" id="slGroup_' +
      g +
      '" data-cat="' +
      g +
      '"><div class="sl-group-head"><span class="sl-group-drag" draggable="true" data-cat="' +
      g +
      '">' +
      ics("grip", 14, 14) +
      '</span><span class="sl-group-ico">' +
      ics(SL_CAT_ICON[g] || "tag", 14, 14) +
      '</span><span class="sl-group-name">' +
      catLabel(g) +
      '</span><span class="sl-group-meta">' +
      gdone +
      "/" +
      glist.length +
      " • " +
      curSym() +
      gsum.toFixed(0) +
      '</span></div><div class="sl-group-items" id="slGroupItems_' +
      g +
      '">';
    glist.forEach(function (it) {
      html += slItemRowHTML(sl, it);
    });
    html += "</div></div>";
  });
  return html;
}
function slItemRowHTML(sl, it) {
  var checked = it.checked ? "checked" : "";
  var chips = "";
  if (it.priority > 0) {
    chips +=
      '<span class="sl-chip-mini pri' +
      it.priority +
      '">' +
      ics("flag", 10, 10) +
      " " +
      (it.priority === 2 ? tr("highPriority") : tr("midPriority")) +
      "</span>";
  }
  if (it.brand) {
    chips +=
      '<span class="sl-chip-mini">' +
      ics("box", 10, 10) +
      " " +
      esc(it.brand) +
      "</span>";
  }
  if (it.store) {
    chips +=
      '<span class="sl-chip-mini">' +
      ics("store", 10, 10) +
      " " +
      esc(it.store) +
      "</span>";
  }
  if (it.reminder) {
    chips +=
      '<span class="sl-chip-mini">' +
      ics("bell", 10, 10) +
      " " +
      esc(it.reminder) +
      "</span>";
  }
  if (it.photo) {
    chips += '<span class="sl-chip-mini">' + ics("camera", 10, 10) + "</span>";
  }
  if (it.voice) {
    chips += '<span class="sl-chip-mini">' + ics("mic", 10, 10) + "</span>";
  }
  var notes =
    it.notes && !it.checked
      ? '<div class="sl-item-note">' + esc(it.notes) + "</div>"
      : "";
  return (
    '<div class="sl-item-row' +
    (it.checked ? " purchased" : "") +
    '" id="slItemRow_' +
    it.id +
    '" draggable="true">' +
    '<div class="sl-item-grip">' +
    ics("grip", 14, 14) +
    "</div>" +
    '<div class="sl-pcb ' +
    checked +
    '" role="checkbox" aria-checked="' +
    (it.checked ? "true" : "false") +
    '" aria-label="' +
    (it.checked ? tr("completed") : tr("incomplete")) +
    '" onclick="event.stopPropagation();toggleShopItem(' +
    sl.id +
    "," +
    it.id +
    ')">' +
    (it.checked ? ics("check", 14, 14) : "") +
    '</div><div class="sl-item-body" onclick="slItemSheet(' +
    sl.id +
    "," +
    it.id +
    ')"><div class="sl-item-line1"><div class="sl-pitem-name' +
    (it.checked ? " purchased" : "") +
    '">' +
    esc(it.name) +
    (it.favorited ? " " + ics("star2", 12, 12) : "") +
    '</div><div class="sl-pitem-price">' +
    curSym() +
    ((it.price || 0) * (it.qty || 1)).toFixed(2) +
    "</div></div>" +
    '<div class="sl-item-qty">&times; ' +
    (it.qty || 1) +
    " " +
    esc(it.unit) +
    (it.price ? " @ " + curSym() + it.price : "") +
    "</div>" +
    (chips ? '<div class="sl-item-chips">' + chips + "</div>" : "") +
    notes +
    "</div></div>"
  );
}
function attachItemInteractions(sl) {
  if (!sl) return;
  document.querySelectorAll(".sl-item-row").forEach(function (row) {
    row.addEventListener("dragstart", function (e) {
      e.dataTransfer.setData("text/plain", row.id.replace("slItemRow_", ""));
      row.classList.add("dragging");
    });
    row.addEventListener("dragend", function () {
      row.classList.remove("dragging");
    });
    row.addEventListener("dragover", function (e) {
      e.preventDefault();
      row.classList.add("drop-over");
    });
    row.addEventListener("dragleave", function () {
      row.classList.remove("drop-over");
    });
    row.addEventListener("drop", function (e) {
      e.preventDefault();
      row.classList.remove("drop-over");
      var from = e.dataTransfer.getData("text/plain");
      if (!from || from === row.id.replace("slItemRow_", "")) return;
      slReorderItems(
        sl.id,
        parseInt(from, 10),
        parseInt(row.id.replace("slItemRow_", ""), 10),
      );
    });
  });
  document.querySelectorAll(".sl-group-head").forEach(function (head) {
    var drag = head.querySelector(".sl-group-drag");
    if (!drag) return;
    drag.addEventListener("dragstart", function (e) {
      e.dataTransfer.setData(
        "text/plain",
        "G:" + drag.getAttribute("data-cat"),
      );
      drag.classList.add("dragging");
    });
    drag.addEventListener("dragend", function () {
      drag.classList.remove("dragging");
    });
  });
  document.querySelectorAll(".sl-group").forEach(function (g) {
    g.addEventListener("dragover", function (e) {
      e.preventDefault();
      if (e.dataTransfer.getData("text/plain").indexOf("G:") === 0)
        g.classList.add("drop-over");
    });
    g.addEventListener("dragleave", function () {
      g.classList.remove("drop-over");
    });
    g.addEventListener("drop", function (e) {
      e.preventDefault();
      g.classList.remove("drop-over");
      var data = e.dataTransfer.getData("text/plain");
      if (data.indexOf("G:") === 0) {
        slReorderGroups(sl.id, data.slice(2), g.getAttribute("data-cat"));
      }
    });
  });
}
function slReorderItems(slId, fromId, toId) {
  var sl = getSL(slId);
  if (!sl) return;
  var fi = sl.items.findIndex(function (i) {
    return i.id === fromId;
  });
  var ti = sl.items.findIndex(function (i) {
    return i.id === toId;
  });
  if (fi < 0 || ti < 0) return;
  var it = sl.items.splice(fi, 1)[0];
  sl.items.splice(ti, 0, it);
  sl.items.forEach(function (x, i) {
    x.order = i;
  });
  slDone(sl);
  renderShoppingDetail();
}
function slReorderGroups(slId, fromCat, toCat) {
  var sl = getSL(slId);
  if (!sl) return;
  var cats = SL_CATS.slice();
  var fi = cats.indexOf(fromCat);
  var ti = cats.indexOf(toCat);
  if (fi < 0 || ti < 0) return;
  var c = cats.splice(fi, 1)[0];
  cats.splice(ti, 0, c);
  SL_CATS = cats;
  save();
  renderShoppingDetail();
}
function slDetailSheet() {
  var sl = getSL(state.activeListId);
  if (!sl) return;
  var items = [
    ["rename", "slRename(" + sl.id + ")", "edit"],
    ["setBudget", "setListBudget()", "tag"],
    ["colorLabel", "slSetColor(" + sl.id + ")", "palette"],
    ["icon", "slChangeIcon()", "grid"],
    ["duplicate", "slDuplicate(" + sl.id + ")", "copy"],
    ["archive", "archiveList()", "archive"],
    ["delete", "deleteList()", "trash2"],
    ["export", "slExportList(" + sl.id + ")", "download"],
    ["move", "slMoveList(" + sl.id + ")", "folder"],
    ["favorite", "slFavorite(" + sl.id + ")", "star"],
    ["pin", "slPin(" + sl.id + ")", "pin"],
    ["clearCompleted", "slClearCompleted()", "check"],
  ];
  var html = "";
  items.forEach(function (it) {
    html +=
      '<div class="bs-item" onclick="slCloseSheet();' +
      it[1] +
      '">' +
      ics(it[2], 18, 18) +
      '<div><div class="lang-native">' +
      tr(it[0]) +
      "</div></div></div>";
  });
  html +=
    '<div class="bs-item" onclick="slCloseSheet()">' +
    ics("x", 18, 18) +
    '<div><div class="lang-native">' +
    tr("cancel") +
    "</div></div></div>";
  showSheet("slDetailOverlay", esc(sl.title), html);
}
function slChangeIcon() {
  var sl = getSL(state.activeListId);
  if (!sl) return;
  var icons = [
    "shoppingBag",
    "cart",
    "leaf",
    "package",
    "star",
    "truck",
    "box",
    "grid",
    "heart",
    "home",
  ];
  var items = icons
    .map(function (ic) {
      return (
        '<button class="sl-pick-ico' +
        (sl.icon === ic ? " active" : "") +
        '" onclick="slApplyIcon(\'' +
        ic +
        "')\">" +
        ics(ic, 18, 18) +
        "</button>"
      );
    })
    .join("");
  showDialog(tr("icon"), '<div class="sl-pick-icos">' + items + "</div>", [
    { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
  ]);
}
function slApplyIcon(ic) {
  var sl = getSL(state.activeListId);
  if (!sl) return;
  sl.icon = ic;
  slDone(sl);
  closeDialog();
  renderShoppingDetail();
}
function slClearCompleted() {
  var sl = getSL(state.activeListId);
  if (!sl) return;
  sl.items = sl.items.filter(function (i) {
    return !i.checked;
  });
  slDone(sl);
  renderShoppingDetail();
  showToast(tr("cleared"));
}
function renderDetailShareBar() {
  var shareBar = document.getElementById("shoppingShareBar");
  if (!shareBar) return;
  shareBar.style.display = "flex";
  shareBar.innerHTML =
    '<div class="sl-share-bar">' +
    ["txt", "pdf", "doc", "print", "web"]
      .map(function (m) {
        var labels = {
          txt: tr("shareText"),
          pdf: tr("sharePDF"),
          doc: tr("shareDoc"),
          print: tr("print"),
          web: tr("shareWeb"),
        };
        var icons = {
          txt: "file",
          pdf: "file",
          doc: "file",
          print: "printer",
          web: "share",
        };
        var fns = {
          txt: "shareAsText",
          pdf: "shareAsPDF",
          doc: "shareAsDoc",
          print: "printList",
          web: "shareWeb",
        };
        var cls = m === "txt" ? "primary" : "";
        return (
          '<button class="sl-share-btn ' +
          cls +
          '" onclick="' +
          fns[m] +
          '()">' +
          ics(icons[m], 14, 14) +
          " " +
          labels[m] +
          "</button>"
        );
      })
      .join("") +
    "</div>";
}
function renderSLSummary() {
  var sl = getSL(state.activeListId);
  if (!sl) return;
  var items = sl.items || [];
  var sum = slTotal(items);
  var purchased = items.filter(function (i) {
    return i.checked;
  }).length;
  var total = items.length;
  var remaining = total - purchased;
  var budget = sl.budget || 0;
  var over = budget > 0 && sum > budget;
  var el = document.getElementById("slSummary");
  el.innerHTML =
    '<div class="sl-psummary"><div class="sl-ps-left"><div class="sl-ps-total">' +
    curSym() +
    sum.toFixed(2) +
    '</div><div class="sl-ps-count">' +
    purchased +
    "/" +
    total +
    " " +
    tr("items") +
    (remaining > 0 ? " • " + remaining + " " + tr("remaining") : "") +
    (budget > 0 ? " • " + (over ? tr("overBudget") : tr("underBudget")) : "") +
    '</div></div><div class="sl-ps-right"><button class="sl-ps-btn" onclick="completeShopping()">' +
    ics("check", 12, 12) +
    " " +
    tr("complete") +
    "</button></div></div>";
}
function quickAddShop() {
  var name = document.getElementById("slQaName").value.trim();
  if (!name) return;
  var qty = parseFloat(document.getElementById("slQaQty").value) || 1;
  var price = parseFloat(document.getElementById("slQaPrice").value) || 0;
  var unit = window._selUnit || "pieces";
  var sl = getSL(state.activeListId);
  if (!sl) return;
  if (!sl.items) sl.items = [];
  sl.items.push(
    slItemNorm({
      id: nextShopItemId++,
      name: name,
      qty: qty,
      unit: unit,
      price: price,
      addedAt: Date.now(),
    }),
  );
  sl.totalExpense = slTotal(sl.items);
  trackRecent(name);
  save();
  document.getElementById("slQaName").value = "";
  document.getElementById("slQaQty").value = "1";
  document.getElementById("slQaPrice").value = "";
  document.getElementById("slQaName").focus();
  renderShoppingDetail();
}
function toggleShopItem(slId, itemId) {
  var sl = getSL(slId);
  if (!sl || !sl.items) return;
  var it = sl.items.find(function (i) {
    return i.id === itemId;
  });
  if (!it) return;
  it.checked = !it.checked;
  slDone(sl);
  renderShoppingDetail();
}
function adjustQty(delta) {
  var inp = document.getElementById("slQaQty");
  if (!inp) return;
  var v = parseFloat(inp.value) || 1;
  v = Math.round((v + delta) * 10) / 10;
  if (v < 0.5) v = 0.5;
  inp.value = v;
}
function toggleSLUnit() {
  var d = document.getElementById("slUnitDropdown");
  if (d) d.classList.toggle("show");
}
function setSLUnit(u) {
  window._selUnit = u;
  var lbl = document.getElementById("slUnitLabel");
  if (lbl) lbl.textContent = u;
  var d = document.getElementById("slUnitDropdown");
  if (d) d.classList.remove("show");
}
function toggleShopItemActions(id) {
  var el = document.getElementById("slActions_" + id);
  if (el) el.classList.toggle("open");
}

/* ---------------- ITEM SHEET & ACTIONS ---------------- */
function slItemSheet(slId, itemId) {
  var sl = getSL(slId);
  if (!sl) return;
  var it = (sl.items || []).find(function (i) {
    return i.id === itemId;
  });
  if (!it) return;
  var items = [
    ["edit", "editShopItem(" + slId + "," + itemId + ")", "edit"],
    ["duplicate", "slDupItem(" + slId + "," + itemId + ")", "copy"],
    ["delete", "slDelItem(" + slId + "," + itemId + ")", "trash2"],
    ["move", "slMoveItem(" + slId + "," + itemId + ")", "folder"],
    ["share", "slShareItem(" + slId + "," + itemId + ")", "share"],
    ["copy", "slCopyItem(" + slId + "," + itemId + ")", "copy"],
    ["favorite", "slFavItem(" + slId + "," + itemId + ")", "star"],
    ["markPurchased", "slMarkItem(" + slId + "," + itemId + ")", "check"],
    ["undo", "slUndoItem(" + slId + "," + itemId + ")", "refresh"],
  ];
  var html = "";
  items.forEach(function (itm) {
    html +=
      '<div class="bs-item" onclick="slCloseSheet();' +
      itm[1] +
      '">' +
      ics(itm[2], 18, 18) +
      '<div><div class="lang-native">' +
      tr(itm[0]) +
      "</div></div></div>";
  });
  html +=
    '<div class="bs-item" onclick="slCloseSheet()">' +
    ics("x", 18, 18) +
    '<div><div class="lang-native">' +
    tr("cancel") +
    "</div></div></div>";
  showSheet("slItemOverlay", esc(it.name), html);
}
function slDupItem(slId, itemId) {
  var sl = getSL(slId);
  if (!sl) return;
  var it = (sl.items || []).find(function (i) {
    return i.id === itemId;
  });
  if (!it) return;
  var copy = JSON.parse(JSON.stringify(it));
  copy.id = nextShopItemId++;
  copy.addedAt = Date.now();
  copy.checked = false;
  sl.items.push(slItemNorm(copy));
  slDone(sl);
  renderShoppingDetail();
  showToast(tr("itemDuplicated"));
}
function slDelItem(slId, itemId) {
  var sl = getSL(slId);
  if (!sl) return;
  var it = (sl.items || []).find(function (i) {
    return i.id === itemId;
  });
  if (!it) return;
  _slItemUndo = { slId: slId, item: JSON.parse(JSON.stringify(it)) };
  sl.items = sl.items.filter(function (i) {
    return i.id !== itemId;
  });
  slDone(sl);
  renderShoppingDetail();
  showUndoToast(tr("itemRemoved"), function () {
    slUndoItem();
  });
}
function slUndoItem() {
  if (!_slItemUndo) return;
  var u = _slItemUndo;
  var sl = getSL(u.slId);
  if (!sl) return;
  sl.items.push(u.item);
  _slItemUndo = null;
  slDone(sl);
  renderShoppingDetail();
  showToast(tr("restored"));
}
function slMoveItem(slId, itemId) {
  var sl = getSL(slId);
  if (!sl) return;
  var it = (sl.items || []).find(function (i) {
    return i.id === itemId;
  });
  if (!it) return;
  var others = state.shoppingLists.filter(function (o) {
    return o.id !== slId && !o.archived;
  });
  var items = others
    .map(function (o) {
      return (
        '<div class="bs-item" onclick="slMoveItemTo(' +
        slId +
        "," +
        itemId +
        "," +
        o.id +
        ')"><div class="sl-ico" style="width:34px;height:34px">' +
        ics(o.icon || "shoppingBag", 16, 16) +
        '</div><div><div class="lang-native">' +
        esc(o.title) +
        "</div></div></div>"
      );
    })
    .join("");
  showSheet(
    "slMoveOverlay",
    tr("moveTo") + " " + esc(it.name),
    items ||
      '<div style="padding:16px 20px;font-size:12px;color:var(--muted)">' +
        tr("noOtherLists") +
        "</div>",
  );
}
function slMoveItemTo(fromSlId, itemId, toSlId) {
  var from = getSL(fromSlId);
  var to = getSL(toSlId);
  if (!from || !to) return;
  var idx = from.items.findIndex(function (i) {
    return i.id === itemId;
  });
  if (idx < 0) return;
  var it = from.items.splice(idx, 1)[0];
  to.items.push(it);
  from.totalExpense = slTotal(from.items);
  to.totalExpense = slTotal(to.items);
  var ov = document.getElementById("slMoveOverlay");
  if (ov) {
    ov.remove();
    setOverlayLock(false);
  }
  save();
  renderShoppingDetail();
  showToast(tr("movedItem"));
}
function slShareItem(slId, itemId) {
  var sl = getSL(slId);
  if (!sl) return;
  var it = (sl.items || []).find(function (i) {
    return i.id === itemId;
  });
  if (!it) return;
  var txt =
    it.name +
    " x " +
    (it.qty || 1) +
    " " +
    it.unit +
    (it.price ? " @ " + curSym() + it.price : "") +
    (it.notes ? "\n" + it.notes : "");
  if (navigator.share) {
    navigator.share({ title: it.name, text: txt }).catch(function () {});
  } else {
    navigator.clipboard
      .writeText(txt)
      .then(function () {
        showToast(tr("textCopied"));
      })
      .catch(function () {
        showToast(tr("textCopied"));
      });
  }
}
function slCopyItem(slId, itemId) {
  var sl = getSL(slId);
  if (!sl) return;
  var it = (sl.items || []).find(function (i) {
    return i.id === itemId;
  });
  if (!it) return;
  var txt =
    it.name +
    " x " +
    (it.qty || 1) +
    " " +
    it.unit +
    (it.price ? " @ " + curSym() + it.price : "");
  navigator.clipboard
    .writeText(txt)
    .then(function () {
      showToast(tr("copied"));
    })
    .catch(function () {
      showToast(tr("copied"));
    });
}
function slFavItem(slId, itemId) {
  var sl = getSL(slId);
  if (!sl) return;
  var it = (sl.items || []).find(function (i) {
    return i.id === itemId;
  });
  if (!it) return;
  it.favorited = !it.favorited;
  slDone(sl);
  renderShoppingDetail();
  showToast(it.favorited ? tr("listFavorited") : tr("listUnfavorited"));
}
function slMarkItem(slId, itemId) {
  toggleShopItem(slId, itemId);
}
function editShopItem(slId, itemId) {
  var sl = getSL(slId);
  if (!sl || !sl.items) return;
  var it = sl.items.find(function (i) {
    return i.id === itemId;
  });
  if (!it) return;
  var catOpts = SL_CATS.map(function (cc) {
    return (
      '<option value="' +
      cc +
      '"' +
      (it.category === cc ? " selected" : "") +
      ">" +
      catLabel(cc) +
      "</option>"
    );
  }).join("");
  var prioOpts = [0, 1, 2]
    .map(function (p) {
      return (
        '<option value="' +
        p +
        '"' +
        (it.priority === p ? " selected" : "") +
        ">" +
        (p === 0
          ? tr("lowPriority")
          : p === 1
            ? tr("midPriority")
            : tr("highPriority")) +
        "</option>"
      );
    })
    .join("");
  var photoThumb = it.photo
    ? '<div class="sl-photo-thumb"><img src="' +
      it.photo +
      '" alt=""><button class="sl-photo-x" aria-label="' +
      tr("delete") +
      '" onclick="slRemoveItemPhoto()">' +
      ics("x", 12, 12) +
      "</button></div>"
    : "";
  showDialog(
    tr("editItem"),
    '<div class="sl-editform">' +
      '<input id="editItemName" class="form-input" value="' +
      esc(it.name) +
      '" placeholder="' +
      tr("itemName") +
      '">' +
      '<div class="sl-edit-2"><input id="editItemQty" class="form-input" type="number" value="' +
      it.qty +
      '" min="0.5" step="0.5" placeholder="' +
      tr("qty") +
      '"><select id="editItemUnit" class="form-input">' +
      UNITS.map(function (u) {
        return (
          "<option" + (it.unit === u ? " selected" : "") + ">" + u + "</option>"
        );
      }).join("") +
      '</select></div><div class="sl-edit-2"><input id="editItemPrice" class="form-input" type="number" value="' +
      (it.price || 0) +
      '" min="0" step="1" placeholder="' +
      tr("priceShort") +
      '"><select id="editItemCat" class="form-input">' +
      catOpts +
      '</select></div><div class="sl-edit-2"><select id="editItemPrio" class="form-input">' +
      prioOpts +
      '</select><input id="editItemBrand" class="form-input" value="' +
      esc(it.brand || "") +
      '" placeholder="' +
      tr("brand") +
      '"></div><input id="editItemStore" class="form-input" value="' +
      esc(it.store || "") +
      '" placeholder="' +
      tr("store") +
      '"><textarea id="editItemNotes" class="form-input sl-textarea" placeholder="' +
      tr("notes") +
      '">' +
      esc(it.notes || "") +
      "</textarea>" +
      '<div class="sl-edit-actions">' +
      '<input type="date" id="editItemReminder" class="form-input" value="' +
      (it.reminder || "") +
      '">' +
      '<button class="sl-edit-act" type="button" onclick="slItemPhoto()">' +
      ics("camera", 14, 14) +
      " " +
      tr("photo") +
      "</button>" +
      '<button class="sl-edit-act" type="button" onclick="slItemVoice()">' +
      ics("mic", 14, 14) +
      " " +
      tr("voiceNote") +
      "</button>" +
      photoThumb +
      "</div>" +
      '<input type="file" id="slPhotoInput" accept="image/*" style="display:none" onchange="slItemPhotoFile(this)">' +
      "</div>",
    [
      { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
      {
        label: tr("save"),
        cls: "btn-primary",
        fn: function () {
          var n = document.getElementById("editItemName").value.trim();
          if (!n) return;
          it.name = n;
          it.qty =
            parseFloat(document.getElementById("editItemQty").value) || 1;
          it.unit = document.getElementById("editItemUnit").value || "pieces";
          it.price =
            parseFloat(document.getElementById("editItemPrice").value) || 0;
          it.category =
            document.getElementById("editItemCat").value || "others";
          it.priority =
            parseInt(document.getElementById("editItemPrio").value, 10) || 0;
          it.brand = document.getElementById("editItemBrand").value.trim();
          it.store = document.getElementById("editItemStore").value.trim();
          it.notes = document.getElementById("editItemNotes").value;
          var rem = document.getElementById("editItemReminder").value;
          it.reminder = rem || null;
          slDone(sl);
          renderShoppingDetail();
          showToast(tr("itemUpdated"));
        },
      },
    ],
  );
  window._editIt = it;
}
function slItemPhoto() {
  var inp = document.getElementById("slPhotoInput");
  if (inp) inp.click();
}
function slItemPhotoFile(inp) {
  var file = inp.files && inp.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function (ev) {
    if (window._editIt) {
      window._editIt.photo = ev.target.result;
      var it = window._editIt;
      var sl = getSL(state.activeListId);
      if (sl) slDone(sl);
      renderShoppingDetail();
      showToast(tr("photoAdded"));
    }
  };
  reader.readAsDataURL(file);
  inp.value = "";
}
function slRemoveItemPhoto() {
  if (window._editIt) {
    window._editIt.photo = null;
    renderShoppingDetail();
  }
}
function slItemVoice() {
  var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) {
    showToast(tr("voiceNotSupported"));
    return;
  }
  try {
    var rec = new SR();
    rec.lang = "en-US";
    rec.interimResults = false;
    rec.onresult = function (e) {
      if (window._editIt) {
        window._editIt.voice = e.results[0][0].transcript;
        var sl = getSL(state.activeListId);
        if (sl) slDone(sl);
        renderShoppingDetail();
        showToast(tr("voiceSaved"));
      }
    };
    rec.onerror = function () {
      showToast(tr("voiceError"));
    };
    rec.start();
    showToast(tr("listening"));
  } catch (ex) {
    showToast(tr("voiceError"));
  }
}

/* ---------------- LIST ACTIONS (detail) ---------------- */
function showListActions() {
  slDetailSheet();
}
function legalAndPrivacy() {
  closeDialog();
  openLegal("privacy");
}
function renameList() {
  slRename(state.activeListId);
}
function setListBudget() {
  var sl = getSL(state.activeListId);
  if (!sl) return;
  showDialog(
    tr("setBudget"),
    '<input id="budgetInput" class="form-input" type="number" value="' +
      (sl.budget || "") +
      '" placeholder="' +
      tr("budgetLabel") +
      '">',
    [
      { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
      {
        label: tr("save"),
        cls: "btn-primary",
        fn: function () {
          var v = parseFloat(document.getElementById("budgetInput").value);
          sl.budget = v > 0 ? v : null;
          slDone(sl);
          renderShoppingDetail();
        },
      },
    ],
  );
}
function deleteList() {
  slDeleteById(state.activeListId);
}
function archiveList() {
  var sl = getSL(state.activeListId);
  if (!sl) return;
  sl.archived = true;
  slDone(sl);
  state.activeListId = null;
  renderShopping();
  showToast(tr("archived"));
}
function completeShopping() {
  var sl = getSL(state.activeListId);
  if (!sl) return;
  var items = sl.items || [];
  var purchased = items.filter(function (i) {
    return i.checked;
  });
  var pending = items.filter(function (i) {
    return !i.checked;
  });
  if (purchased.length === 0) {
    showToast(tr("noItemsChecked"));
    return;
  }
  showDialog(
    tr("completeShopping"),
    tr("moveToPantry") +
      " (" +
      purchased.length +
      " " +
      tr("items").toLowerCase() +
      ")",
    [
      { label: tr("cancel"), cls: "btn-cancel-d", fn: function () {} },
      {
        label: tr("complete"),
        cls: "btn-primary",
        fn: function () {
          purchased.forEach(function (it) {
            state.items.push({
              id: nextItemId++,
              name: it.name,
              category: it.category || "others",
              quantity: it.qty,
              unit: it.unit || "pieces",
              price: it.price || null,
              boughtDate: todayStr,
              expiryDate: (function (d) {
                d.setDate(d.getDate() + 7);
                return d.toISOString().slice(0, 10);
              })(new Date()),
              notes: it.notes || "",
              photoBase64: null,
            });
          });
          sl.items = pending;
          sl.isCompleted = pending.length === 0;
          sl.totalExpense = slTotal(pending);
          sl.completedAt = pending.length === 0 ? Date.now() : 0;
          save();
          state.activeListId = null;
          showToast(tr("addedToInventory"));
          renderShopping();
        },
      },
    ],
  );
}
function shareAsText() {
  var sl = getSL(state.activeListId);
  if (!sl) return;
  var items = sl.items || [];
  var lines = [
    tr("shoppingListTitle").toUpperCase(),
    sl.title + " - " + new Date().toLocaleDateString(),
    "─".repeat(28),
  ];
  items.forEach(function (it) {
    lines.push(
      (it.checked ? "[x]" : "[ ] ") +
        it.name +
        " x " +
        (it.qty || 1) +
        " " +
        it.unit +
        (it.price ? " @ " + curSym() + it.price : ""),
    );
  });
  lines.push("─".repeat(28));
  lines.push(tr("total") + ": " + curSym() + slTotal(items).toFixed(2));
  lines.push("─".repeat(28));
  lines.push(tr("generatedBy"));
  var txt = lines.join("\n");
  navigator.clipboard
    .writeText(txt)
    .then(function () {
      showToast(tr("textCopied"));
    })
    .catch(function () {
      showToast(tr("textCopied"));
    });
}
function shareAsPDF() {
  var w = window.open("", "_blank");
  w.document.write(getPrintHTML());
  w.document.close();
  setTimeout(function () {
    w.print();
    w.close();
  }, 500);
}
function shareAsDoc() {
  var sl = getSL(state.activeListId);
  var html = getPrintHTML();
  var blob = new Blob(
    [
      '<html><head><meta charset="UTF-8"><style>body{font-family:Georgia,serif;padding:40px;color:#333}h1{color:#1B4D1F;font-size:24px;border-bottom:2px solid #9CCF8B;padding-bottom:8px}.meta{color:#666;font-size:14px}table{width:100%;border-collapse:collapse;margin-top:16px}th{background:#9CCF8B;color:#1B4D1F;padding:8px;text-align:left;font-size:12px}td{padding:8px;border-bottom:1px solid #ddd;font-size:12px}.checked td{background:#f0fdf4}.total{font-size:18px;font-weight:700;color:#1B4D1F;text-align:right;margin-top:16px}.footer{font-size:11px;color:#999;margin-top:24px;border-top:1px solid #ddd;padding-top:8px}</style></head><body>' +
        html +
        "</body></html>",
    ],
    { type: "application/msword" },
  );
  var a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "FreshTrack_" + sl.title.replace(/[^a-z0-9]/gi, "_") + ".doc";
  a.click();
  showToast(tr("exportedWord"));
}
function printList() {
  var w = window.open("", "_blank");
  w.document.write(
    '<html><head><meta charset="UTF-8"><style>body{font-family:Georgia,serif;padding:20px;color:#333}@media print{body{padding:0}}h1{color:#1B4D1F;border-bottom:2px solid #9CCF8B;padding-bottom:8px}table{width:100%;border-collapse:collapse;margin-top:12px}th{background:#9CCF8B;color:#1B4D1F;padding:6px;text-align:left;font-size:11px}td{padding:6px;border-bottom:1px solid #eee;font-size:11px}.total{font-size:16px;font-weight:700;color:#1B4D1F;text-align:right;margin-top:12px}.footer{font-size:10px;color:#999;margin-top:16px;border-top:1px solid #ddd;padding-top:6px}</style></head><body>' +
      getPrintHTML() +
      "</body></html>",
  );
  w.document.close();
  setTimeout(function () {
    w.print();
  }, 300);
}
function shareWeb() {
  if (!navigator.share) {
    showToast(tr("webShareNA"));
    return;
  }
  var sl = getSL(state.activeListId);
  if (!sl) return;
  var txt = sl.title + "\n" + slTextItems(sl);
  navigator
    .share({
      title: tr("appName") + " " + tr("shoppingList") + ": " + sl.title,
      text: txt,
    })
    .catch(function () {});
}
function getPrintHTML() {
  var sl = getSL(state.activeListId);
  if (!sl) return "";
  var items = sl.items || [];
  var rows = items
    .map(function (i) {
      return (
        "<tr" +
        (i.checked ? ' class="checked"' : "") +
        "><td>" +
        (i.checked ? "[x]" : "[ ]") +
        "</td><td>" +
        esc(i.name) +
        "</td><td>" +
        (i.qty || 1) +
        "</td><td>" +
        esc(i.unit) +
        "</td><td>" +
        curSym() +
        (i.price || 0).toFixed(2) +
        "</td><td>" +
        esc(i.notes || "") +
        "</td></tr>"
      );
    })
    .join("");
  return (
    "<h1>FreshTrack - " +
    esc(sl.title) +
    '</h1><div class="meta">' +
    new Date().toLocaleDateString() +
    "</div><table><thead><tr><th></th><th>" +
    tr("item") +
    "</th><th>" +
    tr("qty") +
    "</th><th>" +
    tr("unit") +
    "</th><th>" +
    tr("priceShort") +
    "</th><th>" +
    tr("notes") +
    "</th></tr></thead><tbody>" +
    rows +
    '</tbody></table><div class="total">' +
    tr("total") +
    ": " +
    curSym() +
    slTotal(items).toFixed(2) +
    '</div><div class="footer">' +
    tr("generatedBy") +
    "</div>"
  );
}
function slUndoList() {
  slUndoDeleteList();
}

function anaMoney(v) {
  return (
    curSym() +
    Number(v || 0).toLocaleString(undefined, {
      maximumFractionDigits: 0,
    })
  );
}
function anaCountUp(el, target, fmt) {
  if (!el) return;
  var dur = 750;
  var t0 = null;
  function step(ts) {
    if (!t0) t0 = ts;
    var p = Math.min(1, (ts - t0) / dur);
    var ease = 1 - Math.pow(1 - p, 3);
    var val = target * ease;
    el.textContent = fmt ? fmt(val) : Math.round(val);
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
function anaPieChart(data) {
  var total = data.reduce(function (a, d) {
    return a + d.value;
  }, 0);
  if (total <= 0) return '<div class="ana-empty">' + tr("noDataYet") + "</div>";
  var circ = 2 * Math.PI * 15.9;
  var offset = 0;
  var segs = "";
  data.forEach(function (d) {
    if (d.value <= 0) return;
    var frac = d.value / total;
    segs +=
      '<circle cx="21" cy="21" r="15.9" fill="none" stroke="' +
      d.color +
      '" stroke-width="3.8" stroke-linecap="round" stroke-dasharray="' +
      (frac * circ).toFixed(2) +
      " " +
      circ.toFixed(2) +
      '" stroke-dashoffset="' +
      (circ * 0.25 - offset).toFixed(2) +
      '" transform="rotate(-90 21 21)"><animate attributeName="stroke-dasharray" from="0 ' +
      circ.toFixed(2) +
      '" to="' +
      (frac * circ).toFixed(2) +
      " " +
      circ.toFixed(2) +
      '" dur="0.8s" fill="freeze" begin="0s"/></circle>';
    offset += frac * circ;
  });
  return (
    '<div class="ana-pie-wrap"><svg viewBox="0 0 42 42" class="ana-pie">' +
    '<circle cx="21" cy="21" r="15.9" fill="none" class="ana-pie-bg"/>' +
    segs +
    '<text x="21" y="21.5" text-anchor="middle" class="ana-pie-total">' +
    total +
    "</text></svg>" +
    '<div class="ana-legend">' +
    data
      .filter(function (d) {
        return d.value > 0;
      })
      .map(function (d) {
        return (
          '<div class="ana-legend-row"><span class="ana-legend-dot" style="background:' +
          d.color +
          '"></span><span class="ana-legend-label">' +
          d.label +
          '</span><span class="ana-legend-val">' +
          anaMoney(d.value) +
          "</span></div>"
        );
      })
      .join("") +
    "</div></div>"
  );
}
function anaLineChart(labels, values, color, suffix) {
  if (
    !values.length ||
    values.every(function (v) {
      return v === 0;
    })
  )
    return '<div class="ana-empty">' + tr("noDataYet") + "</div>";
  var W = 100,
    H = 36,
    pad = 2;
  var max = Math.max.apply(null, values) || 1;
  var step = values.length > 1 ? (W - pad * 2) / (values.length - 1) : 0;
  var pts = values
    .map(function (v, i) {
      return (
        (pad + i * step).toFixed(1) +
        "," +
        (H - pad - (v / max) * (H - pad * 2)).toFixed(1)
      );
    })
    .join(" ");
  var area =
    (pad + 0 * step).toFixed(1) +
    "," +
    (H - pad) +
    " " +
    pts +
    " " +
    (pad + (values.length - 1) * step).toFixed(1) +
    "," +
    (H - pad);
  var last = values[values.length - 1];
  return (
    '<div class="ana-line-wrap"><svg viewBox="0 0 ' +
    W +
    " " +
    H +
    '" preserveAspectRatio="none" class="ana-line"><defs><linearGradient id="anagrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="' +
    color +
    '" stop-opacity="0.35"/><stop offset="100%" stop-color="' +
    color +
    '" stop-opacity="0"/></linearGradient></defs><polygon points="' +
    area +
    '" fill="url(#anagrad)"/><polyline points="' +
    pts +
    '" fill="none" stroke="' +
    color +
    '" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div class="ana-line-axis">' +
    labels
      .map(function (l, i) {
        var show =
          values.length <= 6 ||
          i % Math.ceil(values.length / 6) === 0 ||
          i === values.length - 1;
        return (
          "<span" + (show ? "" : ' class="ana-axis-hide"') + ">" + l + "</span>"
        );
      })
      .join("") +
    '<span class="ana-line-last">' +
    suffix +
    last +
    "</span></div></div>"
  );
}
function renderAnalytics() {
  applyTheme();
  refreshUI();
  var items = state.items;
  var total = items.length;
  var expired = items.filter(function (i) {
    return daysLeft(i.expiryDate) < 0;
  });
  var soon = items.filter(function (i) {
    var d = daysLeft(i.expiryDate);
    return d >= 0 && d <= 3;
  });
  var totalValue = items.reduce(function (a, i) {
    return a + (i.price || 0) * (i.qty || 1);
  }, 0);
  var wastedValue = expired.reduce(function (a, i) {
    return a + (i.price || 0) * (i.qty || 1);
  }, 0);
  var saved = Math.max(0, totalValue - wastedValue);
  var c = document.getElementById("analyticsContent");
  var cur = curSym();
  var catColors = {
    fruits_veg: "#22C55E",
    dairy_eggs: "#FACC15",
    bakery_bread: "#F97316",
    meat_seafood: "#EF4444",
    pantry_grains: "#8B5CF6",
    beverages: "#06B6D4",
    others: "#64748B",
  };
  c.innerHTML = "";
  // --- quick insights (animated) ---
  c.innerHTML +=
    '<div class="ana-insight-grid">' +
    '<div class="ana-insight" style="--ic:#00C897"><div class="ana-insight-icon">' +
    ics("package", 16, 16) +
    '</div><div class="ana-insight-num" data-anatarget="' +
    total +
    '">0</div><div class="ana-insight-label">' +
    tr("totalItems") +
    "</div></div>" +
    '<div class="ana-insight" style="--ic:#F59E0B"><div class="ana-insight-icon">' +
    ics("tag", 16, 16) +
    '</div><div class="ana-insight-num" data-anamoney="' +
    totalValue +
    '">' +
    cur +
    '0</div><div class="ana-insight-label">' +
    tr("totalValue") +
    "</div></div>" +
    '<div class="ana-insight" style="--ic:#F59E0B"><div class="ana-insight-icon">' +
    ics("clock", 16, 16) +
    '</div><div class="ana-insight-num" data-anatarget="' +
    soon.length +
    '">0</div><div class="ana-insight-label">' +
    tr("expiringSoon") +
    "</div></div>" +
    '<div class="ana-insight" style="--ic:#EF4444"><div class="ana-insight-icon">' +
    ics("alertTriangle", 16, 16) +
    '</div><div class="ana-insight-num" data-anatarget="' +
    expired.length +
    '">0</div><div class="ana-insight-label">' +
    tr("expired") +
    "</div></div>" +
    "</div>";
  // --- money saved + weekly report ---
  var now = new Date();
  var weekAgo = now.getTime() - 7 * 86400000;
  var weekItems = items.filter(function (i) {
    return i.boughtDate && new Date(i.boughtDate).getTime() >= weekAgo;
  });
  var weekSpend = weekItems.reduce(function (a, i) {
    return a + (i.price || 0) * (i.qty || 1);
  }, 0);
  c.innerHTML +=
    '<div class="ana-2col">' +
    '<div class="analytics-card ana-money-card">' +
    '<div class="ana-card-head">' +
    ics("heart", 16, 16) +
    " " +
    tr("moneySaved") +
    "</div>" +
    '<div class="ana-big" data-anamoney="' +
    saved +
    '">' +
    cur +
    "0</div>" +
    '<div class="ana-sub">' +
    tr("estSavings") +
    "</div></div>" +
    '<div class="analytics-card"><div class="ana-card-head">' +
    ics("clock", 16, 16) +
    " " +
    tr("weekLabel") +
    '</div><div class="ana-row"><div class="ana-col"><div class="ana-label">' +
    tr("itemsAdded") +
    '</div><div class="ana-value" data-anatarget="' +
    weekItems.length +
    '">0</div></div><div class="ana-col"><div class="ana-label">' +
    tr("itemsPurchased") +
    '</div><div class="ana-value" data-anatarget="' +
    weekItems.filter(function (i) {
      return i.purchasedAt || i.status === "purchased";
    }).length +
    '">0</div></div><div class="ana-col"><div class="ana-label">' +
    tr("wasted") +
    '</div><div class="ana-value" style="color:#EF4444" data-anamoney="' +
    weekItems
      .filter(function (i) {
        return daysLeft(i.expiryDate) < 0;
      })
      .reduce(function (a, i) {
        return a + (i.price || 0) * (i.qty || 1);
      }, 0) +
    '">' +
    cur +
    "0</div></div></div></div></div>";
  // --- inventory trends (line chart) ---
  var months = {};
  items.forEach(function (i) {
    var d = i.boughtDate || i.expiryDate;
    if (!d) return;
    var m = d.slice(0, 7);
    if (!months[m]) months[m] = { count: 0, spend: 0, waste: 0 };
    months[m].count++;
    months[m].spend += (i.price || 0) * (i.qty || 1);
    if (daysLeft(i.expiryDate) < 0)
      months[m].waste += (i.price || 0) * (i.qty || 1);
  });
  var mKeys = Object.keys(months).sort();
  var last6 = mKeys.slice(-6);
  var tLabels = last6.map(function (m) {
    return m.slice(5) + "/" + m.slice(2, 4);
  });
  var tVals = last6.map(function (m) {
    return months[m].count;
  });
  c.innerHTML +=
    '<div class="analytics-card"><div class="ana-card-head">' +
    ics("trendingUp", 16, 16) +
    " " +
    tr("inventoryTrends") +
    "</div>" +
    anaLineChart(tLabels, tVals, "#00C897", "") +
    "</div>";
  // --- category distribution (donut) ---
  var cats = {
    fruits_veg: 0,
    dairy_eggs: 0,
    bakery_bread: 0,
    meat_seafood: 0,
    pantry_grains: 0,
    beverages: 0,
    others: 0,
  };
  items.forEach(function (i) {
    if (cats[i.category] !== undefined)
      cats[i.category] += (i.price || 0) * (i.qty || 1);
  });
  var pieData = Object.keys(cats)
    .filter(function (k) {
      return cats[k] > 0;
    })
    .map(function (k) {
      return { label: catLabel(k), value: cats[k], color: catColors[k] };
    });
  c.innerHTML +=
    '<div class="analytics-card"><div class="ana-card-head">' +
    ics("pieChart", 16, 16) +
    " " +
    tr("categoryDistribution") +
    "</div>" +
    anaPieChart(pieData) +
    "</div>";
  // --- monthly waste (line) ---
  c.innerHTML +=
    '<div class="analytics-card"><div class="ana-card-head">' +
    ics("leaf", 16, 16) +
    " " +
    tr("monthlyWaste") +
    "</div>" +
    anaLineChart(
      tLabels,
      last6.map(function (m) {
        return months[m].waste;
      }),
      "#EF4444",
      cur,
    ) +
    "</div>";
  // --- weekly + monthly report ---
  var monthStart =
    now.getFullYear() + "-" + String(now.getMonth() + 1).padStart(2, "0");
  var monthItems = items.filter(function (i) {
    var d = i.boughtDate || i.expiryDate;
    return d && d.slice(0, 7) === monthStart;
  });
  var monthSpend = monthItems.reduce(function (a, i) {
    return a + (i.price || 0) * (i.qty || 1);
  }, 0);
  var monthWaste = monthItems
    .filter(function (i) {
      return daysLeft(i.expiryDate) < 0;
    })
    .reduce(function (a, i) {
      return a + (i.price || 0) * (i.qty || 1);
    }, 0);
  c.innerHTML +=
    '<div class="ana-2col">' +
    '<div class="analytics-card"><div class="ana-card-head">' +
    ics("calendar", 16, 16) +
    " " +
    tr("monthlyReport") +
    '</div><div class="ana-row"><div class="ana-col"><div class="ana-label">' +
    tr("itemsAdded") +
    '</div><div class="ana-value" data-anatarget="' +
    monthItems.length +
    '">0</div></div><div class="ana-col"><div class="ana-label">' +
    tr("totalValue") +
    '</div><div class="ana-value" data-anamoney="' +
    monthSpend +
    '">' +
    cur +
    '0</div></div><div class="ana-col"><div class="ana-label">' +
    tr("wasted") +
    '</div><div class="ana-value" style="color:#EF4444" data-anamoney="' +
    monthWaste +
    '">' +
    cur +
    "0</div></div></div></div>" +
    '<div class="analytics-card"><div class="ana-card-head">' +
    ics("trendingUp", 16, 16) +
    " " +
    tr("storageUsage") +
    '</div><div class="bar-chart" id="anaStorageChart"></div></div></div>';
  // storage usage per category
  var catCounts = {
    fruits_veg: 0,
    dairy_eggs: 0,
    bakery_bread: 0,
    meat_seafood: 0,
    pantry_grains: 0,
    beverages: 0,
    others: 0,
  };
  items.forEach(function (i) {
    if (catCounts[i.category] !== undefined) catCounts[i.category]++;
  });
  var maxCat = Math.max.apply(null, Object.values(catCounts)) || 1;
  var sc = "";
  Object.keys(catCounts).forEach(function (k) {
    if (catCounts[k] <= 0) return;
    sc +=
      '<div class="bar-row"><div class="bar-label">' +
      catLabel(k) +
      '</div><div class="bar-track"><div class="bar-fill" style="width:' +
      Math.round((catCounts[k] / maxCat) * 100) +
      "%;background:" +
      (catColors[k] || "#64748B") +
      '"></div></div><div class="bar-val">' +
      catCounts[k] +
      "</div></div>";
  });
  c.innerHTML +=
    '<div class="analytics-card"><div class="ana-card-head">' +
    ics("trendingUp", 16, 16) +
    " " +
    tr("topExpiringItems") +
    '</div><div id="anaTopExpiring"></div></div>';
  var topExp = items
    .filter(function (i) {
      return i.expiryDate && !isNaN(daysLeft(i.expiryDate));
    })
    .sort(function (a, b) {
      return daysLeft(a.expiryDate) - daysLeft(b.expiryDate);
    })
    .slice(0, 5);
  var te = "";
  if (!topExp.length)
    te = '<div class="ana-empty">' + tr("noDataYet") + "</div>";
  topExp.forEach(function (i) {
    var dl = daysLeft(i.expiryDate);
    var st = getStatus(i.expiryDate);
    te +=
      '<div class="ana-top-row"><span class="ana-top-dot ' +
      st +
      '"></span><div class="ana-top-info"><div class="ana-top-name">' +
      esc(i.name) +
      '</div><div class="ana-top-meta">' +
      catLabel(i.category) +
      " · " +
      (dl < 0
        ? fmt(tr("daysAgoTpl"), { n: Math.abs(dl) })
        : dl === 0
          ? tr("expiresToday")
          : dl === 1
            ? tr("expiresTomorrow")
            : fmt(tr("daysLeftTpl"), { n: dl })) +
      '</div></div><div class="ana-top-val">' +
      anaMoney((i.price || 0) * (i.qty || 1)) +
      "</div></div>";
  });
  c.innerHTML +=
    '<div class="analytics-card"><div class="ana-card-head">' +
    ics("shoppingBag", 16, 16) +
    " " +
    tr("mostPurchased") +
    '</div><div id="anaMostPurchased"></div></div>';
  var nameCount = {};
  items.forEach(function (i) {
    var k = (i.name || "").toLowerCase();
    if (!k) return;
    if (!nameCount[k]) nameCount[k] = { name: i.name, n: 0, spend: 0 };
    nameCount[k].n++;
    nameCount[k].spend += (i.price || 0) * (i.qty || 1);
  });
  var mp = Object.keys(nameCount)
    .map(function (k) {
      return nameCount[k];
    })
    .sort(function (a, b) {
      return b.n - a.n;
    })
    .slice(0, 5);
  var mpHtml = "";
  if (!mp.length)
    mpHtml = '<div class="ana-empty">' + tr("noDataYet") + "</div>";
  mp.forEach(function (i, idx) {
    mpHtml +=
      '<div class="ana-top-row"><span class="ana-rank">' +
      (idx + 1) +
      '</span><div class="ana-top-info"><div class="ana-top-name">' +
      esc(i.name) +
      '</div><div class="ana-top-meta">' +
      i.n +
      " " +
      tr("items") +
      '</div></div><div class="ana-top-val">' +
      anaMoney(i.spend) +
      "</div></div>";
  });
  c.innerHTML +=
    '<div class="analytics-card"><div class="ana-card-head">' +
    ics("clock", 16, 16) +
    " " +
    tr("purchaseHistory") +
    '</div><div id="anaPurchaseHistory"></div></div>';
  var ph = items
    .filter(function (i) {
      return i.boughtDate;
    })
    .sort(function (a, b) {
      return (b.boughtDate || "").localeCompare(a.boughtDate || "");
    })
    .slice(0, 8);
  var phHtml = "";
  if (!ph.length)
    phHtml = '<div class="ana-empty">' + tr("noDataYet") + "</div>";
  ph.forEach(function (i) {
    var d = i.boughtDate.split("-");
    var label = d.length === 3 ? d[2] + "/" + d[1] + "/" + d[0] : i.boughtDate;
    phHtml +=
      '<div class="ana-top-row"><span class="ana-top-date">' +
      label +
      '</span><div class="ana-top-info"><div class="ana-top-name">' +
      esc(i.name) +
      '</div><div class="ana-top-meta">' +
      catLabel(i.category) +
      '</div></div><div class="ana-top-val">' +
      anaMoney((i.price || 0) * (i.qty || 1)) +
      "</div></div>";
  });
  c.innerHTML +=
    '<div style="margin:8px 16px;display:flex;gap:8px;flex-wrap:wrap"><button class="backup-btn" onclick="exportAnalyticsCSV()" style="text-align:center">' +
    ics("download", 14, 14) +
    " " +
    tr("exportCSVReport") +
    "</button></div>";
  document.getElementById("anaStorageChart").innerHTML =
    sc ||
    '<div style="font-size:10px;color:var(--muted);text-align:center;padding:12px">' +
      tr("noDataYet") +
      "</div>";
  document.getElementById("anaTopExpiring").innerHTML = te;
  document.getElementById("anaMostPurchased").innerHTML = mpHtml;
  document.getElementById("anaPurchaseHistory").innerHTML = phHtml;
  document.querySelectorAll("[data-anatarget]").forEach(function (el) {
    anaCountUp(el, parseFloat(el.getAttribute("data-anatarget")));
  });
  document.querySelectorAll("[data-anamoney]").forEach(function (el) {
    anaCountUp(el, parseFloat(el.getAttribute("data-anamoney")), function (v) {
      return cur + Math.round(v).toLocaleString();
    });
  });
}
function exportAnalyticsCSV() {
  var csv =
    tr("spendReport") +
    "\n" +
    tr("csvSpendHeader") +
    "\n" +
    state.items.reduce(function (a, i) {
      return a + (i.price || 0) * (i.qty || 1);
    }, 0) +
    "," +
    state.items.length +
    "," +
    state.items
      .filter(function (i) {
        return daysLeft(i.expiryDate) < 0;
      })
      .reduce(function (a, i) {
        return a + (i.price || 0) * (i.qty || 1);
      }, 0) +
    "\n\n" +
    tr("itemName") +
    "," +
    tr("category") +
    "," +
    tr("qty") +
    "," +
    tr("unit") +
    "," +
    tr("priceShort") +
    "," +
    tr("purchaseDate") +
    "," +
    tr("expiryDate") +
    "," +
    tr("notes") +
    "\n";
  state.items.forEach(function (i) {
    csv +=
      '"' +
      String(i.name || "").replace(/"/g, '""') +
      '","' +
      catLabel(i.category) +
      '",' +
      (i.qty || i.quantity || 1) +
      "," +
      (i.unit || "") +
      "," +
      (i.price || 0) +
      "," +
      (i.boughtDate || "") +
      "," +
      (i.expiryDate || "") +
      "," +
      String(i.notes || "").replace(/"/g, '""') +
      "\n";
  });
  var blob = new Blob([csv], { type: "text/csv" });
  var a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "FreshTrack_Analytics.csv";
  a.click();
  showToast(tr("csvExported"));
}

function renderSettings() {
  applyTheme();
  refreshUI();
  var c = document.getElementById("settingsContent");
  var cL = state.lang;
  var curLang = LANG_FLAGS[cL] + " " + LANG_NATIVE[cL];
  var accentColors = {
    green: "#22C55E",
    blue: "#3B82F6",
    purple: "#8B5CF6",
    orange: "#F97316",
  };
  var syms = { INR: "₹", USD: "$", EUR: "€", GBP: "£", JPY: "¥", CNY: "¥" };
  var curSym = syms[state.currency] || "₹";
  var html = "";
  html +=
    '<div class="settings-group"><div class="settings-group-title">' +
    tr("general") +
    '</div><div class="settings-card">';
  html +=
    '<div class="setting-row" onclick="showLangSheet()"><div class="setting-row-left"><div class="setting-row-icon" style="background:rgba(0,200,151,.12);color:var(--accent)">' +
    ics("globe", 16, 16) +
    '</div><div class="setting-row-info"><div class="setting-row-label">' +
    tr("language") +
    '</div><div class="setting-row-sub">' +
    tr("appLanguage") +
    '</div></div></div><div class="setting-row-value">' +
    curLang +
    "</div>" +
    ics("chevronRight", 16, 16) +
    "</div>";
  html +=
    '<div class="setting-row" onclick="showCurrencyPicker()"><div class="setting-row-left"><div class="setting-row-icon" style="background:rgba(251,191,36,.12);color:#F59E0B">' +
    ics("dollar", 16, 16) +
    '</div><div class="setting-row-info"><div class="setting-row-label">' +
    tr("currency") +
    '</div><div class="setting-row-sub">' +
    tr("currencyDesc") +
    '</div></div></div><div class="setting-row-value">' +
    curSym +
    " " +
    state.currency +
    "</div>" +
    ics("chevronRight", 16, 16) +
    "</div>";
  html +=
    '<div class="setting-row" onclick="showDateFormatPicker()"><div class="setting-row-left"><div class="setting-row-icon" style="background:rgba(6,182,212,.12);color:#06B6D4">' +
    ics("calendar", 16, 16) +
    '</div><div class="setting-row-info"><div class="setting-row-label">' +
    tr("dateFormat") +
    '</div><div class="setting-row-sub">' +
    tr("dateFormatDesc") +
    '</div></div></div><div class="setting-row-value">' +
    state.dateFormat +
    "</div>" +
    ics("chevronRight", 16, 16) +
    "</div>";
  html +=
    '<div class="setting-row" onclick="showUnitPicker()"><div class="setting-row-left"><div class="setting-row-icon" style="background:rgba(139,92,246,.12);color:#8B5CF6">' +
    ics("ruler", 16, 16) +
    '</div><div class="setting-row-info"><div class="setting-row-label">' +
    tr("measurement") +
    '</div><div class="setting-row-sub">' +
    tr("measurementDesc") +
    '</div></div></div><div class="setting-row-value">' +
    tr(state.measureUnit === "metric" ? "metricUnit" : "imperialUnit") +
    "</div>" +
    ics("chevronRight", 16, 16) +
    "</div>";
  html += "</div></div>";
  html +=
    '<div class="settings-group"><div class="settings-group-title">' +
    tr("pwa") +
    '</div><div class="settings-card">';
  html +=
    '<div class="setting-row" onclick="installApp()"><div class="setting-row-left"><div class="setting-row-icon" style="background:rgba(16,185,129,.12);color:#10B981">' +
    ics("download", 16, 16) +
    '</div><div class="setting-row-info"><div class="setting-row-label">' +
    tr("installApp") +
    '</div><div class="setting-row-sub">' +
    tr("installAppDesc") +
    '</div></div></div><div class="setting-row-value">' +
    (pwaInstalled ? tr("installed") : tr("notInstalled")) +
    "</div>" +
    ics("chevronRight", 16, 16) +
    "</div>";
  html +=
